<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GWGUI.Tests" />
    <ProjectReference Include="..\GWGUI.Emulation\GWGUI.Emulation.csproj" />
  </ItemGroup>
  <Target Name="CopyAmigaExternalCore" AfterTargets="Build" Condition="Exists('$(MSBuildThisFileDirectory)..\..\artifacts\ppua\puae_libretro.dll')">
    <MakeDir Directories="$(OutDir)Emulation" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\artifacts\ppua\puae_libretro.dll" DestinationFolder="$(OutDir)Emulation" SkipUnchangedFiles="true" />
  </Target>
</Project>
