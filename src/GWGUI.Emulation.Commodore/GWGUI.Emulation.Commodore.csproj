<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>gwgui.emulation.commodore</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\**\*" TargetPath="Assets\Emulation\commodore\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

    <None Update="module.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="GWGUI.Tests" />
    <InternalsVisibleTo Include="GWGUI.LocalEmulationTests" />
    <InternalsVisibleTo Include="GWGUI.LocalDiskImageTests" />
    <ProjectReference Include="..\GWGUI.Emulation\GWGUI.Emulation.csproj" />
  </ItemGroup>
  <ItemGroup>


    <EmbeddedResource Update="Resources\*\*.resx">
      <WithCulture>false</WithCulture>
      <LogicalName>GWGUI.Emulation.Commodore.Resources.%(Filename).$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(Identity)')))).resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="RemoveHostProvidedAssembliesFromCopyLocal" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::Copy('%(ReferenceCopyLocalPaths.Filename)').StartsWith('gwgui.'))" />
    </ItemGroup>
  </Target>
</Project>
