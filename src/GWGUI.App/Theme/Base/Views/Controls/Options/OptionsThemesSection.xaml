<UserControl x:Class="GWGUI.App.Views.Controls.Options.OptionsThemesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions"
             FontWeight="Normal">
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{l:Loc Options.Themes.List}" FontWeight="SemiBold" Margin="6,4,6,12"/>
                <ListBox x:Name="ThemeList" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="10,9"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Appearance}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="8">
                        <Grid MinHeight="100" MaxHeight="340">
                            <TextBlock x:Name="PreviewUnavailable" Text="{l:Loc Options.Themes.PreviewUnavailable}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Image x:Name="Preview" Stretch="Uniform"/>
                        </Grid>
                    </Border>
            <ScrollViewer Grid.Row="1" MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="ThemeName" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,6" TextWrapping="Wrap"/>
                    <TextBlock x:Name="Description" TextWrapping="Wrap" LineHeight="21"/>
                    <TextBlock x:Name="AppearanceHeading" Text="{l:Loc Options.Themes.Appearance}" Margin="0,12,0,4"/>
                    <StackPanel x:Name="Variants" Orientation="Horizontal"/>
                    <TextBlock x:Name="ActiveTheme" Foreground="{DynamicResource MutedTextBrush}" Margin="0,12,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="{l:Loc Options.Themes.ApplyHint}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
            <Button x:Name="SaveTheme" Grid.Row="2" Content="{l:Loc Common.Choose}" HorizontalAlignment="Right"
                    Margin="0,12,0,0" MinWidth="120" Click="SaveClicked"/>
        </Grid>
    </Grid>
</UserControl>
