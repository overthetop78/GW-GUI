<UserControl x:Class="GWGUI.App.Views.Controls.Read.ReadCaptureCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions">
    <Border x:Name="CardBorder" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ExploreButton" Content="{l:Loc Read.OpenExplore}" Margin="0,0,8,0" IsEnabled="False"/>
                <Button x:Name="VisualizeButton" Content="{l:Loc Read.OpenVisualize}" IsEnabled="False"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="FileNameText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="StateText" Margin="0,5,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="SummaryText" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
