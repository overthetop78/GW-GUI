<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="AccentBrush" Color="#4D76E8"/>
    <SolidColorBrush x:Key="WindowBrush" Color="#F1F2F4"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#20242C"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E1E4EA"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EEF2FF"/>
