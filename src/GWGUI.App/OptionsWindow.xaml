<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GWGUI.App.OptionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GWGUI.App.Localization" xmlns:local="clr-namespace:GWGUI.App" Title="{l:Loc Options.Title}" Width="1120" Height="650" MinWidth="980" MinHeight="560" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <ListBox x:Name="Navigation" Margin="16" SelectedIndex="0" SelectionChanged="Navigation_SelectionChanged" AutomationProperties.Name="{l:Loc Options.Title}">
            <ListBoxItem Content="{l:Loc Options.General}" />
            <ListBoxItem Content="{l:Loc Options.Tools}" />
            <ListBoxItem Content="{l:Loc Options.Hardware}" />
            <ListBoxItem Content="{l:Loc Options.Profiles}" />
        </ListBox>
        <Grid Grid.Column="1" Margin="8,16,16,8">
            <StackPanel x:Name="GeneralPage">
                <TextBlock Text="{l:Loc Options.General}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20" />
                <TextBlock Text="{l:Loc Options.ImagesFolder}" />
                <DockPanel Margin="0,6,0,18">
                    <Button DockPanel.Dock="Right" Content="{l:Loc Common.Browse}" Click="BrowseImagesFolder_Click" />
                    <TextBox x:Name="ImagesFolderText" AutomationProperties.Name="{l:Loc Options.ImagesFolder}" />
                </DockPanel>
                <TextBlock Text="{l:Loc Options.Language}" />
                  <ComboBox x:Name="LanguageCombo" Width="240" HorizontalAlignment="Left" Margin="0,6,0,18"
                            DisplayMemberPath="NativeName" SelectionChanged="Language_SelectionChanged"
                            AutomationProperties.Name="{l:Loc Options.Language}" />
                <TextBlock Text="{l:Loc Options.Theme}" />
                <ComboBox x:Name="ThemeCombo" Width="240" HorizontalAlignment="Left" Margin="0,6" AutomationProperties.Name="{l:Loc Options.Theme}">
                    <ComboBoxItem Content="{l:Loc Theme.System}" />
                    <ComboBoxItem Content="{l:Loc Theme.Light}" />
                    <ComboBoxItem Content="{l:Loc Theme.Dark}" />
                </ComboBox>
                <TextBlock Text="{l:Loc Options.TagPattern}" Margin="0,18,0,0" />
                <TextBox x:Name="TagPatternText" Width="240" HorizontalAlignment="Left" Margin="0,6" TextChanged="TagPattern_Changed" AutomationProperties.Name="{l:Loc Options.TagPattern}" />
                <TextBlock Text="{l:Loc Options.TagPatternHelp}" Foreground="#69707D" TextWrapping="Wrap" />
                <TextBlock x:Name="TagPatternPreview" Margin="0,6" />
            </StackPanel>
            <StackPanel x:Name="ToolsPage" Visibility="Collapsed">
                <TextBlock Text="{l:Loc Options.Tools}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20" />
                <TextBlock Text="{l:Loc Options.GwPath}" />
                <DockPanel Margin="0,6">
                    <Button DockPanel.Dock="Right" Content="{l:Loc Common.Choose}" Click="BrowseGw_Click" />
                    <TextBox x:Name="GwPathText" AutomationProperties.Name="{l:Loc Options.GwPath}" />
                </DockPanel>
                <TextBlock Text="{l:Loc Options.ToolsHelp}" Margin="0,18" TextWrapping="Wrap" />
                <WrapPanel>
                    <Button Content="{l:Loc HostTools.Detect}" Click="DetectHostTools_Click" />
                    <Button Content="{l:Loc HostTools.Check}" Click="CheckHostTools_Click" />
                    <Button x:Name="DownloadHostToolsButton" Content="{l:Loc HostTools.Download}" Click="DownloadHostTools_Click" />
                    <Button Content="{l:Loc HostTools.Rollback}" Click="RollbackHostTools_Click" />
                </WrapPanel>
                <ProgressBar x:Name="HostToolsProgress" Height="8" Margin="4,12" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="{l:Loc HostTools.Download}" />
                <TextBlock x:Name="HostToolsStatus" Margin="4,8" TextWrapping="Wrap" />
            </StackPanel>
            <Grid x:Name="HardwarePage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{l:Loc Options.Hardware}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20" />
                <DataGrid Grid.Row="1" x:Name="DrivesGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" AutomationProperties.Name="{l:Loc Options.Hardware}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:Loc Hardware.Port}" Binding="{Binding Port}" Width="75" IsReadOnly="True" />
                        <DataGridTextColumn Header="{l:Loc Hardware.Drive}" Binding="{Binding ReaderLabel}" Width="110" IsReadOnly="True" />
                        <DataGridComboBoxColumn Header="{l:Loc Hardware.PhysicalSize}" SelectedValueBinding="{Binding Size}" ItemsSource="{x:Static local:HardwareChoices.Sizes}" Width="120" />
                        <DataGridComboBoxColumn Header="{l:Loc Hardware.DensityDescription}" SelectedValueBinding="{Binding Density}" ItemsSource="{x:Static local:HardwareChoices.Densities}" Width="115" />
                        <DataGridComboBoxColumn Header="{l:Loc Hardware.SpeedDescription}" SelectedValueBinding="{Binding Rpm}" ItemsSource="{x:Static local:HardwareChoices.Speeds}" Width="130" />
                        <DataGridTextColumn Header="{l:Loc Hardware.ConfigurationState}" Binding="{Binding ConfigurationState}" Width="*" IsReadOnly="True" />
                        <DataGridCheckBoxColumn Header="{l:Loc Hardware.Available}" Binding="{Binding Available}" Width="90" />
                        <DataGridTemplateColumn Width="100">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
                                <Button Content="{l:Loc Common.SaveIcon}" ToolTip="{l:Loc Common.Save}" AutomationProperties.Name="{l:Loc Common.Save}" Click="SaveHardwareRow_Click" Padding="7,3" />
                                <Button Content="{l:Loc Common.TrashIcon}" Foreground="#D73535" ToolTip="{l:Loc Hardware.Forget}" AutomationProperties.Name="{l:Loc Hardware.Forget}" Click="ForgetHardwareRow_Click" Padding="7,3" />
                            </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ScanButton" Content="{l:Loc Hardware.Scan}" Click="ScanHardware_Click" />
                    <Button Content="{l:Loc Hardware.AddDrive}" Click="AddDrive_Click" />
                </StackPanel>
            </Grid>
            <Grid x:Name="ProfilesPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{l:Loc Profiles.ByOperation}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20" />
                <DataGrid Grid.Row="1" x:Name="ProfilesGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" AutomationProperties.Name="{l:Loc Options.Profiles}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:Loc Profiles.Tab}" Binding="{Binding OperationLabel}" Width="160" />
                        <DataGridTextColumn Header="{l:Loc Profiles.Name}" Binding="{Binding Name}" Width="*" />
                        <DataGridCheckBoxColumn Header="{l:Loc Profiles.System}" Binding="{Binding IsSystem}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{l:Loc Profiles.Rename}" Click="RenameProfile_Click" />
                    <Button Content="{l:Loc Common.Delete}" Click="DeleteProfile_Click" />
                </StackPanel>
            </Grid>
        </Grid>
        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="16">
            <Button DockPanel.Dock="Right" Content="{l:Loc Common.Save}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
            <Button DockPanel.Dock="Right" Content="{l:Loc Common.Cancel}" IsCancel="True" />
            <TextBlock Text="{l:Loc Options.HardwarePersistence}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
