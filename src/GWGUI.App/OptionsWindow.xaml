<Window x:Class="GWGUI.App.OptionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options" Width="920" Height="650" MinWidth="800" MinHeight="560" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <ListBox x:Name="Navigation" Margin="16" SelectedIndex="0" SelectionChanged="Navigation_SelectionChanged">
            <ListBoxItem Content="Général"/><ListBoxItem Content="Greaseweazle Tools"/><ListBoxItem Content="Contrôleurs et lecteurs"/><ListBoxItem Content="Profils"/>
        </ListBox>
        <Grid Grid.Column="1" Margin="8,16,16,8">
            <StackPanel x:Name="GeneralPage"><TextBlock Text="Général" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>
                <TextBlock Text="Dossier d’images par défaut"/><DockPanel Margin="0,6,0,18"><Button DockPanel.Dock="Right" Content="Parcourir…" Click="BrowseImagesFolder_Click"/><TextBox x:Name="ImagesFolderText"/></DockPanel>
                <TextBlock Text="Langue"/><ComboBox x:Name="LanguageCombo" Width="240" HorizontalAlignment="Left" Margin="0,6,0,18"><ComboBoxItem Tag="fr" Content="Français"/><ComboBoxItem Tag="en" Content="English"/></ComboBox>
                <TextBlock Text="Thème"/><ComboBox x:Name="ThemeCombo" Width="240" HorizontalAlignment="Left" Margin="0,6"><ComboBoxItem Content="Système"/><ComboBoxItem Content="Clair"/><ComboBoxItem Content="Sombre"/></ComboBox>
            </StackPanel>
            <StackPanel x:Name="ToolsPage" Visibility="Collapsed"><TextBlock Text="Greaseweazle Tools" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/><TextBlock Text="Chemin de gw.exe"/><DockPanel Margin="0,6"><Button DockPanel.Dock="Right" Content="Choisir…" Click="BrowseGw_Click"/><TextBox x:Name="GwPathText"/></DockPanel><TextBlock Text="Si les outils sont absents, l’assistant proposera de les télécharger ou de choisir une installation existante. Les mises à jour sont seulement signalées." Margin="0,18" TextWrapping="Wrap"/></StackPanel>
            <Grid x:Name="HardwarePage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Contrôleurs et lecteurs" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/><DataGrid Grid.Row="1" x:Name="DrivesGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Port" Binding="{Binding Port}" Width="90"/><DataGridTextColumn Header="Identifiant USB" Binding="{Binding UsbId}" Width="*"/><DataGridTextColumn Header="Lecteur" Binding="{Binding Description}" Width="200"/><DataGridCheckBoxColumn Header="Disponible" Binding="{Binding Available}" Width="90"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Scanner" Click="ScanHardware_Click"/><Button Content="Ajouter un lecteur…" Click="AddDrive_Click"/><Button Content="Supprimer"/></StackPanel></Grid>
            <Grid x:Name="ProfilesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Profils par opération" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/><TabControl Grid.Row="1"><TabItem Header="Lecture"><ListBox><ListBoxItem Content="Par défaut"/></ListBox></TabItem><TabItem Header="Écriture"><ListBox><ListBoxItem Content="Par défaut"/></ListBox></TabItem><TabItem Header="Conversion"><ListBox><ListBoxItem Content="Par défaut"/></ListBox></TabItem></TabControl></Grid>
        </Grid>
        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="16"><Button DockPanel.Dock="Right" Content="Enregistrer" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/><Button DockPanel.Dock="Right" Content="Annuler" IsCancel="True"/><TextBlock Text="Les changements matériels restent mémorisés même lorsqu’un lecteur est débranché." VerticalAlignment="Center"/></DockPanel>
    </Grid>
</Window>
