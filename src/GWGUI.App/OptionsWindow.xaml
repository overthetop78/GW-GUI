<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GWGUI.App.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GWGUI.App.Localization"
        xmlns:local="clr-namespace:GWGUI.App"
        Title="{l:Loc Options.Title}" Width="1120" Height="650" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Navigation" SelectedIndex="0" AutomationProperties.Name="{l:Loc Options.Title}">
            <TabItem Header="{l:Loc Options.General}">
                <ScrollViewer x:Name="GeneralScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="390" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{l:Loc Options.ImagesFolder}" />
                                    <TextBox Grid.Row="1" x:Name="ImagesFolderText" Margin="0,6,8,0" VerticalContentAlignment="Center" LostKeyboardFocus="AutoSaveText_LostKeyboardFocus" AutomationProperties.Name="{l:Loc Options.ImagesFolder}" />
                                    <Button Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" Content="{l:Loc Common.Browse}" Click="BrowseImagesFolder_Click" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="6,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="{l:Loc Options.Language}" />
                                        <ComboBox x:Name="LanguageCombo" Margin="0,6,0,0" DisplayMemberPath="NativeName" VerticalContentAlignment="Center" SelectionChanged="Language_SelectionChanged" AutomationProperties.Name="{l:Loc Options.Language}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{l:Loc Options.Theme}" />
                                        <ComboBox x:Name="ThemeCombo" Margin="0,6,0,0" VerticalContentAlignment="Center" SelectionChanged="Theme_SelectionChanged" AutomationProperties.Name="{l:Loc Options.Theme}">
                                            <ComboBoxItem Content="{l:Loc Theme.System}" /><ComboBoxItem Content="{l:Loc Theme.Light}" /><ComboBoxItem Content="{l:Loc Theme.Dark}" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Card}" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="500" /><ColumnDefinition Width="24" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0">
                                    <CheckBox x:Name="UseTagsCheck" Content="{l:Loc Options.UseConversionTags}" Checked="UseTags_Changed" Unchecked="UseTags_Changed" />
                                    <TextBlock Text="{l:Loc Options.TagPreset}" Margin="0,7,0,0" />
                                    <ComboBox x:Name="TagPresetCombo" Width="220" HorizontalAlignment="Left" Margin="0,3,0,0" DisplayMemberPath="Label" SelectionChanged="TagPreset_SelectionChanged" AutomationProperties.Name="{l:Loc Options.TagPreset}" />
                                    <TextBlock Text="{l:Loc Options.TagPattern}" Margin="0,7,0,0" />
                                    <TextBox x:Name="TagPatternText" Width="400" HorizontalAlignment="Left" Margin="0,3,0,0" TextChanged="TagPattern_Changed" LostKeyboardFocus="TagPattern_LostKeyboardFocus" AutomationProperties.Name="{l:Loc Options.TagPattern}" />
                                    <TextBlock Text="{l:Loc Options.RecentTagPatterns}" Margin="0,7,0,0" />
                                    <ListBox x:Name="RecentTagPatterns" Width="400" Height="107" HorizontalAlignment="Left" Margin="0,3,0,0" MouseDoubleClick="RecentTagPattern_DoubleClick" AutomationProperties.Name="{l:Loc Options.RecentTagPatterns}" BorderThickness="0" Background="Transparent" ScrollViewer.CanContentScroll="False" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="MinHeight" Value="0"/></Style></ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate><DataTemplate>
                                            <Grid Height="19">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Margin="0,0,6,0"><TextBlock Text="{Binding Number}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                                <Border Grid.Column="1" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,0"><TextBlock Text="{Binding Display}" VerticalAlignment="Center" /></Border>
                                            </Grid>
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                                <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{l:Loc Options.TagVariablesTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <ItemsControl x:Name="TagVariablesList">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                    <Border Background="#17202A" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"><TextBlock Text="{Binding Token}" Foreground="#65E572" FontFamily="Cascadia Mono,Consolas" VerticalAlignment="Center" /></Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Description}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,7,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Background="#0E1217" BorderBrush="#303B46" BorderThickness="1" CornerRadius="5" Padding="12,8">
                                        <TextBlock x:Name="TagPatternPreview" Foreground="#65E572" FontFamily="Cascadia Mono,Consolas" FontSize="15" VerticalAlignment="Center" />
                                    </Border>
                                    <Button Grid.Column="1" Margin="8,0,0,0" Content="{l:Loc Options.NextTagExampleIcon}" ToolTip="{l:Loc Options.NextTagExample}" Click="NextTagExample_Click" AutomationProperties.Name="{l:Loc Options.NextTagExample}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{l:Loc Options.Hardware}">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <Button x:Name="ScanButton" Content="{l:Loc Hardware.Scan}" Click="ScanHardware_Click" />
                        <Button x:Name="AddDriveButton" Content="{l:Loc Hardware.AddDrive}" Click="AddDrive_Click" />
                    </WrapPanel>
                    <DataGrid Grid.Row="1" x:Name="DrivesGrid" Height="190" Margin="0,10,0,6" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" AutomationProperties.Name="{l:Loc Options.Hardware}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:Loc Hardware.Port}" Binding="{Binding Port}" Width="70" IsReadOnly="True" />
                            <DataGridTextColumn Header="{l:Loc Hardware.Drive}" Binding="{Binding ReaderLabel}" Width="105" IsReadOnly="True" />
                            <DataGridComboBoxColumn Header="{l:Loc Hardware.PhysicalSize}" SelectedValueBinding="{Binding Size}" ItemsSource="{x:Static local:HardwareChoices.Sizes}" Width="115" />
                            <DataGridComboBoxColumn Header="{l:Loc Hardware.DensityDescription}" SelectedValueBinding="{Binding Density}" ItemsSource="{x:Static local:HardwareChoices.Densities}" Width="135" />
                            <DataGridComboBoxColumn Header="{l:Loc Hardware.SpeedDescription}" SelectedValueBinding="{Binding Rpm}" ItemsSource="{x:Static local:HardwareChoices.Speeds}" Width="135" />
                            <DataGridTextColumn Header="{l:Loc Hardware.ConfigurationState}" Binding="{Binding ConfigurationState}" Width="*" IsReadOnly="True" />
                            <DataGridCheckBoxColumn Header="{l:Loc Hardware.Available}" Binding="{Binding Available, Mode=OneWay}" IsReadOnly="True" Width="85" />
                            <DataGridTemplateColumn Width="95">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
                                    <Button Content="{l:Loc Common.SaveIcon}" ToolTip="{l:Loc Common.Save}" AutomationProperties.Name="{l:Loc Common.Save}" Click="SaveHardwareRow_Click" Padding="7,3" />
                                    <Button Content="{l:Loc Common.TrashIcon}" Foreground="#D73535" ToolTip="{l:Loc Hardware.Forget}" AutomationProperties.Name="{l:Loc Hardware.Forget}" Click="ForgetHardwareRow_Click" Padding="7,3" />
                                </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="{l:Loc Options.HardwarePersistence}" Margin="0,0,0,14" />

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:Loc Options.GwPath}" />
                            <TextBox x:Name="GwPathText" Margin="0,6,8,0" LostKeyboardFocus="AutoSaveText_LostKeyboardFocus" AutomationProperties.Name="{l:Loc Options.GwPath}" />
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Bottom" Content="{l:Loc Common.Choose}" Click="BrowseGw_Click" />
                    </Grid>
                    <StackPanel Grid.Row="4">
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="{l:Loc HostTools.Detect}" Click="DetectHostTools_Click" />
                            <Button Content="{l:Loc HostTools.Check}" Click="CheckHostTools_Click" />
                            <Button x:Name="DownloadHostToolsButton" Content="{l:Loc HostTools.Download}" Click="DownloadHostTools_Click" />
                            <Button Content="{l:Loc HostTools.Rollback}" Click="RollbackHostTools_Click" />
                        </WrapPanel>
                        <ProgressBar x:Name="HostToolsProgress" Height="8" Margin="4,8" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="{l:Loc HostTools.Download}" />
                        <TextBlock x:Name="HostToolsStatus" Margin="4,4" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="{l:Loc Options.Profiles}">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <GroupBox Header="{l:Loc Tab.Read}" Margin="0,0,8,0">
                        <ListBox x:Name="ReadProfilesList" Margin="8" PreviewMouseLeftButtonDown="ProfileList_PreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="ProfileList_PreviewMouseRightButtonDown" KeyDown="ProfileList_KeyDown" AutomationProperties.Name="{l:Loc Tab.Read}" DisplayMemberPath="Name">
                            <ListBox.ContextMenu><ContextMenu><MenuItem Header="{l:Loc Profiles.Rename}" Click="RenameProfile_Click" /><MenuItem Header="{l:Loc Common.Delete}" Click="DeleteProfile_Click" /></ContextMenu></ListBox.ContextMenu>
                        </ListBox>
                    </GroupBox>
                    <GroupBox Grid.Column="1" Header="{l:Loc Tab.Write}" Margin="4,0">
                        <ListBox x:Name="WriteProfilesList" Margin="8" PreviewMouseLeftButtonDown="ProfileList_PreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="ProfileList_PreviewMouseRightButtonDown" KeyDown="ProfileList_KeyDown" AutomationProperties.Name="{l:Loc Tab.Write}" DisplayMemberPath="Name">
                            <ListBox.ContextMenu><ContextMenu><MenuItem Header="{l:Loc Profiles.Rename}" Click="RenameProfile_Click" /><MenuItem Header="{l:Loc Common.Delete}" Click="DeleteProfile_Click" /></ContextMenu></ListBox.ContextMenu>
                        </ListBox>
                    </GroupBox>
                    <GroupBox Grid.Column="2" Header="{l:Loc Tab.Convert}" Margin="8,0,0,0">
                        <ListBox x:Name="ConvertProfilesList" Margin="8" PreviewMouseLeftButtonDown="ProfileList_PreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="ProfileList_PreviewMouseRightButtonDown" KeyDown="ProfileList_KeyDown" AutomationProperties.Name="{l:Loc Tab.Convert}" DisplayMemberPath="Name">
                            <ListBox.ContextMenu><ContextMenu><MenuItem Header="{l:Loc Profiles.Rename}" Click="RenameProfile_Click" /><MenuItem Header="{l:Loc Common.Delete}" Click="DeleteProfile_Click" /></ContextMenu></ListBox.ContextMenu>
                        </ListBox>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <Button x:Name="CloseButton" Grid.Row="1" HorizontalAlignment="Right" Margin="0,12,0,0" MinWidth="120"
                Content="{l:Loc Common.Close}" IsDefault="True" Click="Close_Click" />
    </Grid>
</Window>
