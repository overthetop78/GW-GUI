<Window x:Class="GWGUI.App.GwToolWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="590" MinWidth="680" MinHeight="500" WindowStartupLocation="CenterOwner">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <Border Grid.Row="1" Style="{StaticResource Card}"><TextBlock x:Name="Summary" Text="Prêt à exécuter." TextWrapping="Wrap"/></Border>
        <Expander Grid.Row="2" Header="Sortie brute" IsExpanded="True"><TextBox x:Name="RawOutput" Margin="0,10,0,12" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/></Expander>
        <Border Grid.Row="3" Background="#11151B" CornerRadius="6" Padding="10"><TextBox x:Name="CommandText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#B7F7C3" FontFamily="Consolas"/></Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Fermer" IsCancel="True"/><Button x:Name="ExecuteButton" Content="Exécuter" Style="{StaticResource PrimaryButton}" Click="Execute_Click"/></StackPanel>
    </Grid>
</Window>
