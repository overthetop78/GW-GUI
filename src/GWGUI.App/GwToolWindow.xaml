<Window x:Class="GWGUI.App.GwToolWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GWGUI.App.Localization" Width="760" Height="590" MinWidth="680" MinHeight="500" WindowStartupLocation="CenterOwner"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/><WrapPanel x:Name="ParametersPanel" Grid.Row="1" Margin="0,0,0,10"/><Border Grid.Row="2" Style="{StaticResource Card}"><TextBlock x:Name="Summary" Text="{l:Loc Tool.Ready}" TextWrapping="Wrap"/></Border><Expander Grid.Row="3" Header="{l:Loc Tool.RawOutput}" IsExpanded="True"><TextBox x:Name="RawOutput" Margin="0,10,0,12" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/></Expander><Border Grid.Row="4" Background="#11151B" CornerRadius="6" Padding="10"><TextBox x:Name="CommandText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="#B7F7C3" FontFamily="Consolas"/></Border><StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="{l:Loc Common.Close}" IsCancel="True"/><Button x:Name="ExecuteButton" Content="{l:Loc Common.Execute}" Style="{StaticResource PrimaryButton}" Click="Execute_Click"/></StackPanel></Grid></Window>
