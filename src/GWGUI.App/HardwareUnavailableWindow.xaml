<Window x:Class="GWGUI.App.HardwareUnavailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GWGUI.App.Localization"
        Title="{l:Loc Hardware.StartupTitle}" SizeToContent="WidthAndHeight"
        MinWidth="600" MaxWidth="760" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="22">
        <TextBlock Text="{l:Loc Hardware.StartupMissing}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Text="{l:Loc Hardware.StartupExplanation}" Margin="0,8,0,12" TextWrapping="Wrap" />
        <ListBox x:Name="MissingControllers" MinHeight="70" MaxHeight="220"
                 AutomationProperties.Name="{l:Loc Hardware.StartupMissingList}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="ContinueButton" Content="{l:Loc Hardware.StartupContinue}" Click="Choice_Click" Tag="Continue" />
            <Button x:Name="SettingsButton" Content="{l:Loc Hardware.StartupSettings}" Click="Choice_Click" Tag="OpenSettings" />
            <Button x:Name="RetryButton" Content="{l:Loc Hardware.StartupRetry}" Style="{StaticResource PrimaryButton}"
                    Click="Choice_Click" Tag="Retry" />
        </StackPanel>
    </StackPanel>
</Window>
