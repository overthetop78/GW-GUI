<Window x:Class="GWGUI.App.ProfileNameWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Enregistrer le profil" Width="460" Height="190" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Nom du profil" FontWeight="SemiBold"/><TextBox x:Name="NameText" Grid.Row="1" Margin="0,8,0,16"/><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Annuler" IsCancel="True"/><Button Content="Enregistrer" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel></Grid>
</Window>
