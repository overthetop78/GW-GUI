<Window x:Class="GWGUI.App.ConversionConflictWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GWGUI.App.Localization" Title="{l:Loc Conflict.Title}" Width="760" Height="470" WindowStartupLocation="CenterOwner"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="{l:Loc Conflict.Heading}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{l:Loc Conflict.Help}" Margin="0,6,0,14"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="{l:Loc Conflict.File}" Binding="{Binding FileName}" Width="*" IsReadOnly="True"/><DataGridTemplateColumn Header="{l:Loc Conflict.Action}" Width="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedChoice}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid><DockPanel Grid.Row="2" Margin="0,14,0,0"><StackPanel Orientation="Horizontal"><Button Content="{l:Loc Conflict.AllOverwrite}" Tag="Overwrite" Click="ApplyAll_Click"/><Button Content="{l:Loc Conflict.AllSkip}" Tag="Skip" Click="ApplyAll_Click"/><Button Content="{l:Loc Conflict.AllNumber}" Tag="Number" Click="ApplyAll_Click"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="{l:Loc Common.Cancel}" IsCancel="True"/><Button Content="{l:Loc Common.Continue}" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Continue_Click"/></StackPanel></DockPanel></Grid></Window>
