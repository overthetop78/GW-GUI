<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>GW GUI</AssemblyName>
    <RootNamespace>GWGUI.App</RootNamespace>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <Authors>overthetop78</Authors>
    <Company>GW GUI</Company>
    <Product>GW GUI</Product>
    <Description>Modern Windows interface for Greaseweazle.</Description>
    <Copyright>Copyright © overthetop78</Copyright>
    <RepositoryUrl>https://github.com/overthetop78/GW-GUI</RepositoryUrl>
    <SatelliteResourceLanguages>en;fr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GWGUI.Domain\GWGUI.Domain.csproj" />
    <ProjectReference Include="..\GWGUI.Infrastructure\GWGUI.Infrastructure.csproj" />
    <ProjectReference Include="..\GWGUI.Scp\GWGUI.Scp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\docs\user-guide.fr.md" Link="Documentation\user-guide.fr.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\user-guide.en.md" Link="Documentation\user-guide.en.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\docs\images\*.png" Link="Documentation\images\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\app-icon.png" />
  </ItemGroup>

</Project>
