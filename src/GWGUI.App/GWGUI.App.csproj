<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>gwgui.app</AssemblyName>
    <RootNamespace>GWGUI.App</RootNamespace>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <Authors>overthetop78</Authors>
    <Company>GW GUI</Company>
    <Product>GW GUI</Product>
    <Description>Modern Windows interface for Greaseweazle.</Description>
    <Copyright>Copyright © overthetop78</Copyright>
    <RepositoryUrl>https://github.com/overthetop78/GW-GUI</RepositoryUrl>
    <SatelliteResourceLanguages>ar-SA;cs-CZ;da-DK;de-DE;el-GR;en-US;es-ES;fi-FI;fr-FR;he-IL;hu-HU;id-ID;it-IT;ja-JP;ko-KR;nb-NO;nl-NL;pl-PL;pt-BR;pt-PT;ro-RO;ru-RU;sv-SE;th-TH;tr-TR;uk-UA;vi-VN;zh-Hans;zh-Hant</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GWGUI.Tests" />
    <ProjectReference Include="..\GWGUI.Domain\GWGUI.Domain.csproj" />
    <ProjectReference Include="..\GWGUI.Infrastructure\GWGUI.Infrastructure.csproj" />
    <ProjectReference Include="..\GWGUI.MediaEngine\GWGUI.MediaEngine.csproj" />
    <ProjectReference Include="..\GWGUI.Emulation\GWGUI.Emulation.csproj" />
    <ProjectReference Include="..\GWGUI.Emulation.Amiga\GWGUI.Emulation.Amiga.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.4" />
    <PackageReference Include="Veldrid" Version="4.9.0" />
    <PackageReference Include="Veldrid.SPIRV" Version="1.0.15" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\docs\user-guide\*.pdf" Link="Documentation\user-guide\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\DiskDefinitions\built-in.cfg" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\app-icon.png" />
  </ItemGroup>

</Project>
