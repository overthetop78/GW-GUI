<UserControl x:Class="GWGUI.App.Controls.VisualizerLegend" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GWGUI.App.Localization">
 <WrapPanel Margin="4,2">
  <StackPanel Orientation="Horizontal" Margin="0,0,20,0"><Border Width="18" Height="10" Background="#24B35D" Margin="0,0,7,0"/><TextBlock Text="{l:Loc Visual.NormalFlux}"/></StackPanel>
  <StackPanel Orientation="Horizontal" Margin="0,0,20,0"><Border Width="18" Height="10" Background="#8F68FF" Margin="0,0,7,0"/><TextBlock Text="{l:Loc Visual.ShortTransition}"/></StackPanel>
  <StackPanel Orientation="Horizontal" Margin="0,0,20,0"><Border Width="18" Height="10" Background="#53ADFF" Margin="0,0,7,0"/><TextBlock Text="{l:Loc Visual.LongTransition}"/></StackPanel>
  <StackPanel Orientation="Horizontal" Margin="0,0,20,0"><Border Width="18" Height="10" Background="#FFCD40" Margin="0,0,7,0"/><TextBlock Text="{l:Loc Visual.StructureHeader}"/></StackPanel>
  <StackPanel Orientation="Horizontal" Margin="0,0,20,0"><Border Width="18" Height="10" Background="#43DCFF" Margin="0,0,7,0"/><TextBlock Text="{l:Loc Visual.StructureData}"/></StackPanel>
  <StackPanel Orientation="Horizontal"><Border Width="18" Height="10" Background="#FF4B60" Margin="0,0,7,0"/><TextBlock Text="{l:Loc Visual.StructureAnomaly}"/></StackPanel>
 </WrapPanel>
</UserControl>
