<UserControl x:Class="GWGUI.App.Controls.VisualizerHeaderSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GWGUI.App.Localization">
    <Border Style="{StaticResource Card}" Padding="14">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="30" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock x:Name="FileName" Text="{l:Loc Visual.NoFile}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Summary" Text="{l:Loc Visual.Waiting}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{l:Loc Visual.Decoder}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <ComboBox x:Name="Decoder" Width="230" DisplayMemberPath="Name" AutomationProperties.Name="{l:Loc Visual.Decoder}"/>
                <CheckBox x:Name="LinkZoom" Content="{l:Loc Visual.LinkZoom}" IsChecked="True" VerticalAlignment="Center" Margin="14,0"/>
                <Button x:Name="Reset"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/><TextBlock Text="{l:Loc Common.Reset}"/></StackPanel></Button>
                <Button x:Name="Open"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/><TextBlock Text="{l:Loc Visual.OpenImage}"/></StackPanel></Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
