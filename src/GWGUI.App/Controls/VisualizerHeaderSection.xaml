<UserControl x:Class="GWGUI.App.Controls.VisualizerHeaderSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GWGUI.App.Localization">
    <Border Style="{StaticResource Card}" Padding="14">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" FontSize="30" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock x:Name="FileName" Text="{l:Loc Visual.NoFile}" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Summary" Text="{l:Loc Visual.Waiting}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="Decoder" Width="1" Height="1" Visibility="Collapsed" DisplayMemberPath="Name"/>
                <CheckBox x:Name="LinkZoom" Content="{l:Loc Visual.LinkZoom}" IsChecked="True" VerticalAlignment="Center" Margin="14,0"/>
                <Button x:Name="Reset" AutomationProperties.Name="{l:Loc Common.Reset}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/><TextBlock Text="{l:Loc Common.Reset}"/></StackPanel></Button>
                <Button x:Name="Open" AutomationProperties.Name="{l:Loc Visual.OpenImage}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/><TextBlock Text="{l:Loc Visual.OpenImage}"/></StackPanel></Button>
            </StackPanel>
            <controls:DiskClassificationSelector xmlns:controls="clr-namespace:GWGUI.App.Controls" x:Name="Classification" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0"/>
        </Grid>
    </Border>
</UserControl>
