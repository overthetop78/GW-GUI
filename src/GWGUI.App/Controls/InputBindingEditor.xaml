<UserControl x:Class="GWGUI.App.Controls.InputBindingEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GWGUI.App.Localization">
 <UserControl.Resources>
  <Style x:Key="BindingActionButton" TargetType="Button"><Setter Property="Height" Value="38"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Padding" Value="14,6"/><Setter Property="Margin" Value="4,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#C9D0DA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#F3F7FC"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#8DA9C9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#E6EFF9"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0,0,1,0"/><Setter Property="BorderBrush" Value="#E1E6ED"/><Setter Property="Padding" Value="12,7"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="14,10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#D8DEE8"/></Style>
  <Style TargetType="DataGridRow"><Setter Property="Height" Value="56"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#E1E6ED"/><Style.Triggers><DataTrigger Binding="{Binding State}" Value="Conflict"><Setter Property="Background" Value="#FFF1F1"/></DataTrigger><DataTrigger Binding="{Binding State}" Value="Reserved"><Setter Property="Background" Value="#F3F7FF"/></DataTrigger></Style.Triggers></Style>
 </UserControl.Resources>
 <Grid Margin="8,4,8,8" HorizontalAlignment="Stretch">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,12">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid HorizontalAlignment="Left" Width="390">
    <TextBox x:Name="SearchBox" Height="42" Padding="40,8,10,8" VerticalContentAlignment="Center" TextChanged="SearchChanged"/>
    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <TextBlock x:Name="SearchPlaceholder" Margin="42,0,8,0" Foreground="#77808F" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </Grid>
   <Button Grid.Column="1" Style="{StaticResource BindingActionButton}" Click="RestoreDefaultsClicked"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,9,0"/><TextBlock Text="{l:Loc Emulation.RestoreDefaultBindings}"/></StackPanel></Button>
   <Button Grid.Column="2" Style="{StaticResource BindingActionButton}" Click="ClearConflictsClicked"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,9,0"/><TextBlock Text="{l:Loc Emulation.ClearConflicts}"/></StackPanel></Button>
  </Grid>
  <Border Grid.Row="1" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
   <DataGrid x:Name="BindingsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="None" MinHeight="250" MaxHeight="430" RowHeight="56" ColumnHeaderHeight="46" IsReadOnly="True" SelectionMode="Single" Background="Transparent" BorderThickness="0" FontWeight="Normal">
    <DataGrid.Columns>
     <DataGridTemplateColumn x:Name="TargetColumn" Header="{l:Loc Emulation.EmulatedKey}" Width="1.05*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid VerticalAlignment="Stretch"><TextBlock Text="{Binding Label}" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Normal"/></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="{l:Loc Emulation.Binding}" Width="1.85*"><DataGridTemplateColumn.CellTemplate><DataTemplate><ItemsControl ItemsSource="{Binding BindingParts}" VerticalAlignment="Center"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel VerticalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border BorderBrush="#CDD4DE" BorderThickness="1" CornerRadius="5" Padding="9,4" Background="#FAFBFC" VerticalAlignment="Center"><TextBlock Text="{Binding Text}" VerticalAlignment="Center"/></Border><TextBlock Text="+" Margin="8,0" VerticalAlignment="Center" Visibility="{Binding SeparatorVisibility}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="{l:Loc Emulation.BindingState}" Width="1.35*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid VerticalAlignment="Center"><Border Background="{Binding StateBackground}" CornerRadius="14" Padding="11,5" HorizontalAlignment="Left" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Border Width="17" Height="17" CornerRadius="9" BorderBrush="{Binding StateForeground}" BorderThickness="1.5" Margin="0,0,7,0"><TextBlock Text="{Binding StateIcon}" FontSize="11" Foreground="{Binding StateForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding StateText}" Foreground="{Binding StateForeground}" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Border></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="{l:Loc Emulation.InputActions}" Width="Auto"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Tag="{Binding}" Click="AssignClicked" Style="{StaticResource BindingActionButton}" MinWidth="130"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0"/><TextBlock Text="{l:Loc Emulation.AssignInput}"/></StackPanel></Button><Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="ClearClicked" ToolTip="{l:Loc Common.Delete}" Style="{StaticResource BindingActionButton}" MinWidth="46" Padding="9"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
  </Border>
  <TextBlock x:Name="Legend" Grid.Row="2" Margin="4,10,4,0" TextWrapping="Wrap"/>
 </Grid>
</UserControl>
