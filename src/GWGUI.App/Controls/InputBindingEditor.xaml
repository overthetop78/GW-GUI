<UserControl x:Class="GWGUI.App.Controls.InputBindingEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GWGUI.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" MinWidth="280" MaxWidth="460" HorizontalAlignment="Left"
                     VerticalContentAlignment="Center" TextChanged="SearchChanged"/>
            <Button Grid.Column="1" Margin="8,0,0,0" Content="{l:Loc Emulation.RestoreDefaultBindings}" Click="RestoreDefaultsClicked"/>
            <Button Grid.Column="2" Margin="8,0,0,0" Content="{l:Loc Emulation.ClearConflicts}" Click="ClearConflictsClicked"/>
        </Grid>
        <DataGrid x:Name="BindingsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" MinHeight="250" MaxHeight="480"
                  IsReadOnly="True" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:Loc Emulation.EmulatedKey}" Binding="{Binding Label}" Width="1.1*"/>
                <DataGridTextColumn Header="{l:Loc Emulation.Binding}" Binding="{Binding Binding}" Width="1.6*"/>
                <DataGridTemplateColumn Header="{l:Loc Emulation.BindingState}" Width="1*">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <Border Background="{Binding StateBackground}" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateForeground}" FontWeight="SemiBold"/>
                        </Border>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{l:Loc Emulation.InputActions}" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{l:Loc Emulation.AssignInput}" Tag="{Binding}" Click="AssignClicked" MinWidth="105" Margin="3"/>
                            <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" Tag="{Binding}" Click="ClearClicked"
                                    ToolTip="{l:Loc Common.Delete}" MinWidth="40" Margin="3"/>
                        </StackPanel>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="Legend" Grid.Row="2" Margin="4,10,4,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
