<UserControl x:Class="GWGUI.App.Controls.WriteAdvancedSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GWGUI.App.Localization">
    <Expander Header="{l:Loc Common.Advanced}">
        <Border Style="{StaticResource Card}" Margin="0,10,0,12">
            <StackPanel>
                <WrapPanel>
                    <CheckBox x:Name="NoVerify" IsChecked="{Binding Write.NoVerify.Enabled, Mode=TwoWay}" Content="{l:Loc Write.NoVerify}" Foreground="#B3261E" Margin="8" Checked="Input_Changed" Unchecked="Input_Changed" ToolTip="{l:Loc Write.NoVerifyTip}"/>
                    <CheckBox x:Name="EraseEmpty" IsChecked="{Binding Write.EraseEmpty.Enabled}" Content="{l:Loc Write.EraseEmpty}" Margin="16,8" Checked="Input_Changed" Unchecked="Input_Changed" ToolTip="{l:Loc Advanced.EraseEmptyTip}"/>
                    <CheckBox x:Name="RetriesEnabled" IsChecked="{Binding Write.Retries.Enabled}" Content="{l:Loc Read.Retries}" Margin="16,8,8,8" Checked="Input_Changed" Unchecked="Input_Changed" ToolTip="{l:Loc Advanced.RetriesTip}"/>
                    <TextBox x:Name="RetriesValue" Width="70" Text="{Binding Write.Retries.Value, UpdateSourceTrigger=PropertyChanged}" TextChanged="Input_Changed"/>
                </WrapPanel>
                <WrapPanel>
                    <CheckBox x:Name="TracksEnabled" IsChecked="{Binding Write.Tracks.Enabled}" Content="{l:Loc Read.Tracks}" Margin="8" Checked="Input_Changed" Unchecked="Input_Changed" ToolTip="{l:Loc Advanced.TracksTip}"/>
                    <TextBox x:Name="TracksValue" Width="190" Text="{Binding Write.Tracks.Value, UpdateSourceTrigger=PropertyChanged}" TextChanged="Input_Changed" ToolTip="{l:Loc Advanced.TrackSpecTip}"/>
                    <CheckBox x:Name="PreErase" IsChecked="{Binding Write.PreErase.Enabled}" Content="{l:Loc Advanced.PreErase}" Margin="18,8" Checked="Input_Changed" Unchecked="Input_Changed" ToolTip="{l:Loc Advanced.PreEraseTip}"/>
                    <CheckBox x:Name="Reverse" IsChecked="{Binding Write.Reverse.Enabled}" Content="{l:Loc Advanced.Reverse}" Margin="8" Checked="Input_Changed" Unchecked="Input_Changed" ToolTip="{l:Loc Advanced.ReverseTip}"/>
                </WrapPanel>
                <WrapPanel>
                    <CheckBox x:Name="FakeIndexEnabled" IsChecked="{Binding Write.FakeIndex.Enabled}" Content="{l:Loc Advanced.FakeIndex}" Margin="8" Checked="FakeIndex_Checked" Unchecked="Input_Changed" ToolTip="{l:Loc Advanced.FakeIndexTip}"/>
                    <TextBox x:Name="FakeIndexValue" Width="90" Text="{Binding Write.FakeIndex.Value, UpdateSourceTrigger=PropertyChanged}" TextChanged="Input_Changed" ToolTip="{l:Loc Advanced.SpeedTip}"/>
                    <CheckBox x:Name="HardSectors" IsChecked="{Binding Write.HardSectors.Enabled}" Content="{l:Loc Advanced.HardSectors}" Margin="18,8" Checked="HardSectors_Checked" Unchecked="Input_Changed" ToolTip="{l:Loc Advanced.HardSectorsTip}"/>
                    <CheckBox x:Name="PrecompEnabled" IsChecked="{Binding Write.Precomp.Enabled}" Content="{l:Loc Advanced.Precomp}" Margin="18,8,8,8" Checked="Input_Changed" Unchecked="Input_Changed" ToolTip="{l:Loc Advanced.PrecompOptionTip}"/>
                    <TextBox x:Name="PrecompValue" Width="170" Text="{Binding Write.Precomp.Value, UpdateSourceTrigger=PropertyChanged}" TextChanged="Input_Changed" ToolTip="{l:Loc Advanced.PrecompTip}"/>
                </WrapPanel>
                <WrapPanel>
                    <CheckBox x:Name="DenselEnabled" IsChecked="{Binding Write.Densel.Enabled}" Content="{l:Loc Advanced.DensityPin}" Margin="8" Checked="Densel_Checked" Unchecked="Input_Changed" ToolTip="{l:Loc Advanced.DenselTip}"/>
                    <ComboBox x:Name="DenselValue" Width="70" SelectedValuePath="Content" SelectedValue="{Binding Write.Densel.Value}" SelectionChanged="Input_Changed"><ComboBoxItem Content="H"/><ComboBoxItem Content="L"/></ComboBox>
                    <CheckBox x:Name="Tg43" IsChecked="{Binding Write.Tg43.Enabled}" Content="{l:Loc Advanced.Tg43}" Margin="18,8" Checked="Tg43_Checked" Unchecked="Input_Changed" ToolTip="{l:Loc Advanced.Tg43Tip}"/>
                </WrapPanel>
                <DockPanel Margin="8,4" ToolTip="{l:Loc Advanced.DiskDefsTip}"><Button x:Name="BrowseDiskDefs" DockPanel.Dock="Right" Content="{l:Loc Common.Browse}"/><CheckBox x:Name="DiskDefsEnabled" IsChecked="{Binding Write.DiskDefs.Enabled}" Content="{l:Loc Advanced.DiskDefs}" VerticalAlignment="Center" Checked="Input_Changed" Unchecked="Input_Changed"/><TextBox x:Name="DiskDefsValue" Margin="10,0" IsReadOnly="True" Text="{Binding Write.DiskDefs.Value, Mode=TwoWay}" TextChanged="Input_Changed"/></DockPanel>
                <TextBlock Text="{l:Loc Common.ExpertArguments}" Margin="8,12,8,4"/>
                <TextBox x:Name="ExpertArguments" Margin="8" Text="{Binding Write.ExpertArguments, UpdateSourceTrigger=PropertyChanged}" TextChanged="Input_Changed" ToolTip="{l:Loc Common.ExpertArgumentsTip}"/>
            </StackPanel>
        </Border>
    </Expander>
</UserControl>
