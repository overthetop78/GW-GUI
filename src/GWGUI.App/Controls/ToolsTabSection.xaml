<UserControl x:Class="GWGUI.App.Controls.ToolsTabSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GWGUI.App.Localization" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <ListBox x:Name="ToolSelector" SelectedIndex="0" SelectionChanged="ToolSelector_SelectionChanged" AutomationProperties.AutomationId="ToolsList">
            <ListBoxItem Content="{l:Loc Tools.Erase}"/>
            <ListBoxItem Content="{l:Loc Tools.Clean}"/>
        </ListBox>
        <Grid Grid.Column="1" Margin="16,0,0,0">
            <Border x:Name="EraseSection" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:Loc Tools.Erase}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{l:Loc Tools.EraseWarning}" Foreground="#B3261E" Margin="0,8,0,18"/>
                    <WrapPanel>
                        <CheckBox x:Name="EraseTracksEnabledInput" Content="{l:Loc Tools.LimitTracks}" Margin="8" Checked="Input_Changed" Unchecked="Input_Changed"/>
                        <TextBox x:Name="EraseTracksValueInput" Width="180" Text="c=0-79:h=0-1" TextChanged="Input_Changed" automation:AutomationProperties.Name="{l:Loc Tools.LimitTracks}"/>
                        <CheckBox x:Name="EraseRevsEnabledInput" Content="{l:Loc Tools.Revolutions}" Margin="18,8,8,8" Checked="Input_Changed" Unchecked="Input_Changed"/>
                        <TextBox x:Name="EraseRevsValueInput" Width="70" Text="3" TextChanged="Input_Changed" automation:AutomationProperties.Name="{l:Loc Tools.Revolutions}"/>
                    </WrapPanel>
                    <TextBlock Text="{l:Loc Common.ExpertArguments}" Margin="8,14,8,4"/>
                    <TextBox x:Name="EraseExpertArgumentsInput" Margin="8" TextChanged="Input_Changed" automation:AutomationProperties.Name="{l:Loc Common.ExpertArguments}"/>
                    <Button x:Name="EraseButton" Content="{l:Loc Common.Execute}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" AutomationProperties.AutomationId="EraseExecuteButton"/>
                </StackPanel>
            </Border>
            <Border x:Name="CleanSection" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{l:Loc Tools.Clean}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{l:Loc Tools.CleanWarning}" Foreground="#8A4B00" Margin="0,8,0,18"/>
                    <WrapPanel>
                        <CheckBox x:Name="CleanCylindersEnabledInput" Content="{l:Loc Tools.Cylinders}" Margin="8" Checked="Input_Changed" Unchecked="Input_Changed"/>
                        <TextBox x:Name="CleanCylindersValueInput" Width="70" Text="80" TextChanged="Input_Changed" automation:AutomationProperties.Name="{l:Loc Tools.Cylinders}"/>
                        <CheckBox x:Name="CleanPassesEnabledInput" Content="{l:Loc Tools.Passes}" Margin="18,8,8,8" Checked="Input_Changed" Unchecked="Input_Changed"/>
                        <TextBox x:Name="CleanPassesValueInput" Width="70" Text="3" TextChanged="Input_Changed" automation:AutomationProperties.Name="{l:Loc Tools.Passes}"/>
                        <CheckBox x:Name="CleanLingerEnabledInput" Content="{l:Loc Tools.Linger}" Margin="18,8,8,8" Checked="Input_Changed" Unchecked="Input_Changed"/>
                        <TextBox x:Name="CleanLingerValueInput" Width="80" Text="100" TextChanged="Input_Changed" automation:AutomationProperties.Name="{l:Loc Tools.Linger}"/>
                    </WrapPanel>
                    <TextBlock Text="{l:Loc Common.ExpertArguments}" Margin="8,14,8,4"/>
                    <TextBox x:Name="CleanExpertArgumentsInput" Margin="8" TextChanged="Input_Changed" automation:AutomationProperties.Name="{l:Loc Common.ExpertArguments}"/>
                    <Button x:Name="CleanButton" Content="{l:Loc Common.Execute}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" AutomationProperties.AutomationId="CleanExecuteButton"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
