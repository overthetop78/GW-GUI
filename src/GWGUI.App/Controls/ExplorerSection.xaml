<UserControl x:Class="GWGUI.App.Controls.ExplorerSection" x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GWGUI.App.Controls"
             xmlns:l="clr-namespace:GWGUI.App.Localization">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <controls:CardSection Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{l:Loc Explorer.Image}" Margin="0,0,0,5"/>
                    <TextBox x:Name="PathText" Height="38" IsReadOnly="True" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="{l:Loc Explorer.Format}" Margin="0,0,0,5"/>
                    <ComboBox x:Name="FormatCombo" Height="38" VerticalContentAlignment="Center" SelectionChanged="FormatCombo_SelectionChanged"/>
                </StackPanel>
                <Button x:Name="ReadDiskButton" Grid.Column="2" Height="38" MinHeight="0" VerticalAlignment="Bottom" Margin="0,0,8,0" Content="{l:Loc Explorer.ReadDisk}"/>
                <Button x:Name="OpenButton" Grid.Column="3" Height="38" MinHeight="0" VerticalAlignment="Bottom" Content="{l:Loc Explorer.OpenImage}"/>
            </Grid>
        </controls:CardSection>

        <controls:CardSection Grid.Row="1" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{l:Loc Explorer.Volume}" Foreground="#687080"/><TextBlock x:Name="VolumeNameText" FontSize="18" FontWeight="SemiBold" Text="—"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="{l:Loc Explorer.FileSystem}" Foreground="#687080"/><TextBlock x:Name="FileSystemText" FontWeight="SemiBold" Text="—"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="{l:Loc Explorer.Capacity}" Foreground="#687080"/><TextBlock x:Name="CapacityText" FontWeight="SemiBold" Text="—"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="{l:Loc Explorer.Free}" Foreground="#687080"/><TextBlock x:Name="FreeText" FontWeight="SemiBold" Text="—"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="{l:Loc Explorer.Entries}" Foreground="#687080"/><TextBlock x:Name="EntryCountText" FontWeight="SemiBold" Text="—"/></StackPanel>
            </Grid>
        </controls:CardSection>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
            <controls:CardSection Padding="8" Margin="0,0,6,0">
                <TreeView x:Name="FileTree" BorderThickness="0" Background="Transparent" SelectedItemChanged="FileTree_SelectedItemChanged">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type controls:ExplorerEntryItem}" ItemsSource="{Binding Children}">
                            <DockPanel Margin="2">
                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" Width="24" Foreground="#2878C8"/>
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text="{Binding SizeText}" Foreground="#687080" Margin="12,0,0,0"/>
                            </DockPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.Resources>
                </TreeView>
            </controls:CardSection>
            <controls:CardSection Grid.Column="1" Padding="16" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock x:Name="SelectedNameText" FontSize="21" FontWeight="SemiBold" Text="{l:Loc Explorer.SelectEntry}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SelectedTypeText" Grid.Row="1" Foreground="#687080" Margin="0,5,0,18"/>
                    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{l:Loc Explorer.Size}" Foreground="#687080"/><TextBlock x:Name="SelectedSizeText" FontWeight="SemiBold" Text="—"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{l:Loc Explorer.Modified}" Foreground="#687080"/><TextBlock x:Name="SelectedModifiedText" FontWeight="SemiBold" Text="—"/></StackPanel></Grid>
                    <TextBlock Grid.Row="3" Text="{l:Loc Explorer.Comment}" Foreground="#687080" Margin="0,18,0,4"/>
                    <TextBlock x:Name="SelectedCommentText" Grid.Row="4" Text="—" TextWrapping="Wrap"/>
                    <StackPanel Grid.Row="5" VerticalAlignment="Bottom"><TextBlock x:Name="WarningTitle" Text="{l:Loc Explorer.Warnings}" Foreground="#9A6700" Visibility="Collapsed"/><TextBlock x:Name="WarningsText" Foreground="#9A6700" TextWrapping="Wrap" Visibility="Collapsed"/></StackPanel>
                </Grid>
            </controls:CardSection>
        </Grid>

        <Border x:Name="LoadingOverlay" Grid.RowSpan="3" Background="#CCFFFFFF" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="280" Height="8" IsIndeterminate="True"/>
                <TextBlock Text="{l:Loc Explorer.Loading}" Margin="0,12,0,0" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
