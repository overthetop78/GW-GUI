<UserControl x:Class="GWGUI.App.Controls.ExplorerDetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GWGUI.App.Controls">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Margin="4,2,4,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <controls:FileEntryIcon x:Name="DetailsIcon" Width="24" Height="24" VerticalAlignment="Center"/>
            <TextBlock x:Name="DetailsTitle" Grid.Column="1" FontSize="17" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="2">
            <Grid x:Name="DetailRow1" Margin="4,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock x:Name="DetailLabel1" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock x:Name="DetailValue1" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Grid>
            <Grid x:Name="DetailRow2" Margin="4,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock x:Name="DetailLabel2" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock x:Name="DetailValue2" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Grid>
            <Grid x:Name="DetailRow3" Margin="4,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock x:Name="DetailLabel3" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock x:Name="DetailValue3" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Grid>
            <Grid x:Name="DetailRow4" Margin="4,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock x:Name="DetailLabel4" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock x:Name="DetailValue4" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Grid>
            <Grid x:Name="DetailRow5" Margin="4,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock x:Name="DetailLabel5" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock x:Name="DetailValue5" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Grid>
            <Grid x:Name="DetailRow6" Margin="4,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock x:Name="DetailLabel6" Foreground="{DynamicResource MutedTextBrush}"/>
                <TextBlock x:Name="DetailValue6" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
