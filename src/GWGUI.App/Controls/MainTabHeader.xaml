<UserControl x:Class="GWGUI.App.Controls.MainTabHeader" x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Icon, ElementName=Root}" FontFamily="{StaticResource IconFontFamily}" FontSize="17" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Text, ElementName=Root}" VerticalAlignment="Center"/>
    </StackPanel>
</UserControl>
