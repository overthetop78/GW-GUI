<UserControl x:Class="GWGUI.App.Controls.VisualizerTrackOverview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GWGUI.App.Controls" Visibility="Collapsed">
 <Border Style="{StaticResource Card}" Padding="12,7">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><controls:TrackProgressStrip x:Name="Face0" Margin="0,1"/><controls:TrackProgressStrip x:Name="Face1" Margin="0,1"/></StackPanel>
   <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="Face0Count" Foreground="#24A85A" FontWeight="SemiBold"/><TextBlock x:Name="Face1Count" Foreground="#24A85A" FontWeight="SemiBold"/></StackPanel>
  </Grid>
 </Border>
</UserControl>
