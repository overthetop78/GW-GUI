<UserControl x:Class="GWGUI.App.Controls.WriteFormatSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GWGUI.App.Localization" xmlns:controls="clr-namespace:GWGUI.App.Controls">
    <controls:CardSection>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
                <Button x:Name="Modify" DockPanel.Dock="Right" Content="{l:Loc Common.Modify}"/>
                <StackPanel>
                    <TextBlock Text="{l:Loc Write.Detected}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Detection" Text="{l:Loc Write.ChooseImage}" Margin="0,5,12,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
            <ComboBox Grid.Row="1" x:Name="Formats" Margin="0,12,0,0" Visibility="Collapsed" DisplayMemberPath="DisplayName" AutomationProperties.Name="{l:Loc Write.Detected}"/>
        </Grid>
    </controls:CardSection>
</UserControl>
