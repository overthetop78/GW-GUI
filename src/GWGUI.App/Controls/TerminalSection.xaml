<UserControl x:Class="GWGUI.App.Controls.TerminalSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GWGUI.App.Localization">
    <Border Background="#0B0F14" BorderBrush="#303A46" BorderThickness="1" CornerRadius="10" Padding="14" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Text="{l:Loc Terminal.Prompt}" Foreground="#54E88B" FontFamily="Consolas" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" x:Name="Command" Background="Transparent" Foreground="#B7F7C3" BorderThickness="0" Padding="0,4" IsReadOnly="True" FontFamily="Consolas" AutomationProperties.Name="{l:Loc Common.Command}"/>
            </Grid>
            <TextBox Grid.Row="1" x:Name="Output" Margin="0,5,42,0" Background="Transparent" Foreground="#D9DEE7" BorderThickness="0" Padding="0" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Hidden" AcceptsReturn="True" Text="{l:Loc Status.Ready}" AutomationProperties.Name="{l:Loc Tool.RawOutput}"/>
            <Button x:Name="Copy" Grid.Row="1" Style="{StaticResource TerminalIconButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" ToolTip="{l:Loc Common.Copy}" AutomationProperties.Name="{l:Loc Common.Copy}"><Path Width="17" Height="17" Data="M5,2 H15 V12 H12 M2,5 H12 V15 H2 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round" Stretch="Uniform"/></Button>
        </Grid>
    </Border>
</UserControl>
