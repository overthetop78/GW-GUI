<UserControl x:Class="GWGUI.App.Controls.ProfileSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GWGUI.App.Localization" xmlns:controls="clr-namespace:GWGUI.App.Controls">
    <controls:CardSection>
        <StackPanel>
            <TextBlock Text="{l:Loc Common.Profile}" FontWeight="SemiBold"/>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="Profiles" MinWidth="0" DisplayMemberPath="Name" AutomationProperties.Name="{l:Loc Common.Profile}"/>
                <Button x:Name="Save" Grid.Column="1" Content="{l:Loc Icon.Save}" FontFamily="{StaticResource IconFontFamily}" ToolTip="{l:Loc Common.Save}" AutomationProperties.Name="{l:Loc Common.Save}"/>
                <Button x:Name="Reset" Grid.Column="2" Content="{l:Loc Icon.Reset}" FontFamily="{StaticResource IconFontFamily}" ToolTip="{l:Loc Common.Reset}" AutomationProperties.Name="{l:Loc Common.Reset}"/>
            </Grid>
        </StackPanel>
    </controls:CardSection>
</UserControl>
