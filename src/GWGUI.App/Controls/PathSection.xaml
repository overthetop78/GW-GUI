<UserControl x:Class="GWGUI.App.Controls.PathSection" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GWGUI.App.Localization" xmlns:controls="clr-namespace:GWGUI.App.Controls">
    <controls:CardSection Padding="12">
        <StackPanel>
            <TextBlock Text="{Binding Label, ElementName=Root}" Margin="0,0,0,5"/>
            <Grid Height="42">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="PathInput" Height="38" VerticalAlignment="Center" VerticalContentAlignment="Center" IsReadOnly="True" Text="{Binding Text, ElementName=Root, Mode=TwoWay}"/>
                <Button x:Name="Browse" Grid.Column="1" Height="38" MinHeight="0" Margin="6,0,0,0" VerticalAlignment="Center" Content="{l:Loc Common.Browse}"/>
            </Grid>
        </StackPanel>
    </controls:CardSection>
</UserControl>
