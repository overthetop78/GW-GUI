<Application x:Class="GWGUI.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:selectionConstants="clr-namespace:GWGUI.App.Constants.Controls.Selection"
             >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/ApplicationStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Window" BasedOn="{StaticResource ApplicationWindowStyle}">
                <EventSetter Event="Loaded" Handler="Window_Loaded"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
