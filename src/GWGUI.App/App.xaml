<Application x:Class="GWGUI.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:selectionConstants="clr-namespace:GWGUI.App.Constants.Controls.Selection"
             >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Base/Tokens.xaml" />
                <ResourceDictionary Source="Theme/Base/Views/Styles/ApplicationStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Window" BasedOn="{StaticResource ApplicationWindowStyle}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
