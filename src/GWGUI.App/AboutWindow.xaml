<Window x:Class="GWGUI.App.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GWGUI.App.Localization" Title="{l:Loc Menu.About}" Width="620" Height="650" MinWidth="560" MinHeight="520" WindowStartupLocation="CenterOwner">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
            <Image Source="Assets/app-icon.png" Width="112" Height="112" AutomationProperties.Name="{l:Loc App.Title}"/>
            <TextBlock Text="{l:Loc App.Title}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Margin="0,4,0,18"/>
            <TextBlock Text="{l:Loc About.Description}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"/>
            <TextBlock Text="{l:Loc About.License}" HorizontalAlignment="Center" Margin="0,14,0,22"/>
            <TextBlock Text="{l:Loc About.Components}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ItemsControl x:Name="ComponentVersions"><ItemsControl.ItemTemplate><DataTemplate>
                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Version}" FontFamily="Consolas" Margin="24,0,0,0"/>
                </Grid>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></ScrollViewer>
        <Button Grid.Row="1" Content="{l:Loc Common.Close}" IsCancel="True" HorizontalAlignment="Right" Margin="0,18,0,0"/>
    </Grid>
</Window>
