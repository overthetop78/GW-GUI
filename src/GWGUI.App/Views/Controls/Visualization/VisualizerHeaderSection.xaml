<UserControl x:Class="GWGUI.App.Views.Controls.Visualization.VisualizerHeaderSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions"
             xmlns:common="clr-namespace:GWGUI.App.Views.Controls.Common">
    <common:CardSection x:Name="HeaderCardRoot" Padding="10">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <common:MediaDocumentIdentity x:Name="DocumentIdentity" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <ComboBox x:Name="Decoder" Width="1" Height="1" Visibility="Collapsed" DisplayMemberPath="Name"/>
                <ComboBox x:Name="RepresentationChoice" Width="220" Height="30" Margin="0,0,8,0" FontSize="11"
                          DisplayMemberPath="Name" Visibility="Collapsed" SelectionChanged="RepresentationChoice_SelectionChanged"/>
                <Border x:Name="RevolutionControl" Width="220" Padding="2" Margin="0,0,8,0" Background="#FFFFFFFF"
                        BorderBrush="#FFCAD4DB" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{l:Loc Visual.RevolutionLabel}" Margin="7,0,5,0" VerticalAlignment="Center"
                                   Foreground="#FF52616D" FontSize="11" FontWeight="SemiBold"/>
                        <ComboBox x:Name="RevolutionChoice" Grid.Column="1" Height="26" Padding="7,2" FontSize="11"
                                  FontWeight="SemiBold" DisplayMemberPath="Label" SelectionChanged="RevolutionChoice_SelectionChanged"/>
                    </Grid>
                </Border>
                <CheckBox x:Name="LinkZoom" Content="{l:Loc Visual.LinkZoom}" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="Reset" Margin="0,0,8,0" Padding="8,5" AutomationProperties.Name="{l:Loc Common.Reset}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,5,0"/><TextBlock Text="{l:Loc Common.Reset}" FontSize="11"/></StackPanel>
                </Button>
                <Button x:Name="Open" Padding="8,5" AutomationProperties.Name="{l:Loc Visual.OpenImage}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xED25;" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,5,0"/><TextBlock Text="{l:Loc Visual.OpenImage}" FontSize="11"/></StackPanel>
                </Button>
                <Button x:Name="ManualOptionsButton" Width="40" Height="40" MinWidth="0" MinHeight="0" Padding="0" Margin="8,0,0,0"
                        Click="ManualOptionsButton_Click" ToolTip="{l:Loc Common.Advanced}" AutomationProperties.Name="{l:Loc Common.Advanced}">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFontFamily}" FontSize="16"/>
                </Button>
            </StackPanel>
            <Popup x:Name="ManualOptionsPopup" Placement="Custom" PlacementTarget="{Binding ElementName=ManualOptionsButton}"
                   CustomPopupPlacementCallback="ManualOptionsPopup_Place" AllowsTransparency="True" StaysOpen="False">
                <Border Margin="0,8,0,12" Padding="14" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.22"/></Border.Effect>
                    <common:DiskClassificationSelector x:Name="Classification" ShowAutomatic="False"/>
                </Border>
            </Popup>
        </Grid>
    </common:CardSection>
</UserControl>
