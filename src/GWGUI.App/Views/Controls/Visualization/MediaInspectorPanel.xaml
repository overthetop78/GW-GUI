<UserControl x:Class="GWGUI.App.Views.Controls.Visualization.MediaInspectorPanel"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:levels="clr-namespace:GWGUI.App.Enums.ViewModels.Visualization"
             Focusable="False"
             KeyboardNavigation.TabNavigation="Continue"
             automation:AutomationProperties.Name="{Binding Model.Title, ElementName=Root}"
             automation:AutomationProperties.HelpText="{Binding Model.SelectedElement, ElementName=Root}">
    <Grid Margin="9,7" MinHeight="96">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="True">
            <TextBlock Text="{Binding SurfaceTitle, ElementName=Root}" FontSize="11" FontWeight="SemiBold"
                       Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Model.SelectedElement, ElementName=Root, TargetNullValue=—, FallbackValue=—}"
                       FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                       automation:AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
        <ScrollViewer Grid.Row="1" Margin="0,6,0,0" Focusable="False"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Model.Sections, ElementName=Root}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,5" Margin="0,0,7,2" CornerRadius="5"
                                Background="#FFF3F6F8" BorderBrush="#FFDCE4E9" BorderThickness="1"
                                automation:AutomationProperties.Name="{Binding Title}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="SemiBold"
                                       Margin="0,0,0,4" VerticalAlignment="Center"/>
                            <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                                                    automation:AutomationProperties.Name="{Binding Label}"
                                                    automation:AutomationProperties.HelpText="{Binding Value}">
                                            <TextBlock Text="{Binding Label}" FontSize="10"
                                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,3,0"/>
                                            <TextBlock Text="{Binding Value, TargetNullValue=—, FallbackValue=—}"
                                                       FontSize="10" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static levels:MediaInspectorEntryLevel.Warning}">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Level}" Value="{x:Static levels:MediaInspectorEntryLevel.Error}">
                                                                <Setter Property="Foreground" Value="#FFCF4343"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Unit}" FontSize="10" Margin="3,0,0,0"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
