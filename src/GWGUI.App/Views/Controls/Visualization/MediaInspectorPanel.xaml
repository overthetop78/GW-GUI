<UserControl x:Class="GWGUI.App.Views.Controls.Visualization.MediaInspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:levels="clr-namespace:GWGUI.App.Enums.ViewModels.Visualization"
             MinWidth="240"
             Focusable="False"
             KeyboardNavigation.TabNavigation="Continue"
             automation:AutomationProperties.Name="{Binding Title}"
             automation:AutomationProperties.HelpText="{Binding SelectedElement}">
    <Border Style="{StaticResource VisualizerSurface}" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="2,0,2,12">
                <TextBlock Text="{Binding Title}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           automation:AutomationProperties.Name="{Binding Title}"/>
                <TextBlock Text="{Binding SelectedElement}"
                           Margin="0,3,0,0"
                           Foreground="{DynamicResource MutedTextBrush}"
                           automation:AutomationProperties.LiveSetting="Polite"
                           automation:AutomationProperties.Name="{Binding SelectedElement}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedElement}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SelectedElement}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          Focusable="False"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource VisualizerInformationCard}"
                                    automation:AutomationProperties.Name="{Binding Title}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Icon}"
                                                   FontFamily="{StaticResource IconFontFamily}"
                                                   FontSize="17"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="15"
                                                   automation:AutomationProperties.Name="{Binding Title}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3"
                                                      Focusable="False"
                                                      automation:AutomationProperties.Name="{Binding Label}"
                                                      automation:AutomationProperties.HelpText="{Binding Value}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="MinMax(90,*)"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               automation:AutomationProperties.Name="{Binding Label}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,12,0"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Value, TargetNullValue=—, FallbackValue=—}"
                                                               FontWeight="SemiBold"
                                                               automation:AutomationProperties.Name="{Binding Value, TargetNullValue=—, FallbackValue=—}"
                                                               TextAlignment="Right"
                                                               TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static levels:MediaInspectorEntryLevel.Warning}">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static levels:MediaInspectorEntryLevel.Error}">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                        <Setter Property="TextDecorations" Value="Underline"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Unit}"
                                                               Margin="4,0,0,0"
                                                               automation:AutomationProperties.Name="{Binding Unit}"
                                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
