<UserControl x:Class="GWGUI.App.Views.Controls.Visualization.VisualizerTabSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:visualization="clr-namespace:GWGUI.App.Views.Controls.Visualization"
             xmlns:common="clr-namespace:GWGUI.App.Views.Controls.Common"
             xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions">
    <Grid Margin="16" MinWidth="0" MinHeight="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <visualization:VisualizerHeaderSection x:Name="HeaderSection"/>

        <Grid x:Name="VisualizationArea" Grid.Row="1" Margin="0,10,0,8" MinWidth="0" MinHeight="240" ClipToBounds="True">
            <Border x:Name="MediaSurface" Style="{StaticResource VisualizerSurface}" Padding="4"
                    MinWidth="0" MinHeight="0" Visibility="Collapsed">
            <Grid x:Name="MediaViewHost" MinWidth="0" MinHeight="0" ClipToBounds="True">
                <Grid x:Name="FluxViewHost">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <visualization:ScpDiskView x:Name="Side0" Margin="4"/>
                    <visualization:ScpDiskView x:Name="Side1" Grid.Column="1" Margin="4"/>
                </Grid>
            </Grid>
            </Border>

            <Border x:Name="EmptyState" Style="{StaticResource VisualizerSurface}" Padding="32">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                    <Border Width="72" Height="72" CornerRadius="36" Background="#EAF2F7" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFontFamily}" FontSize="32"
                                   Foreground="#34566C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{l:Loc Visual.NoFile}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock Text="{l:Loc Visual.Waiting}" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,6,0,18"/>
                    <Button x:Name="EmptyOpenButton" HorizontalAlignment="Center" AutomationProperties.Name="{l:Loc Visual.OpenImage}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xED25;" FontFamily="{StaticResource IconFontFamily}" Margin="0,0,8,0"/>
                            <TextBlock Text="{l:Loc Visual.OpenImage}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Border x:Name="InspectorBand" Grid.Row="2" Style="{StaticResource VisualizerSurface}"
                Margin="0,0,0,4" Height="118" MinHeight="118" MaxHeight="118" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <visualization:MediaInspectorPanel x:Name="Face0Inspector"/>
                <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" Margin="0,4"/>
                <visualization:MediaInspectorPanel x:Name="Face1Inspector" Grid.Column="2"/>
            </Grid>
        </Border>

        <Border x:Name="OverviewBar" Grid.Row="3" Style="{StaticResource VisualizerSurface}" Padding="5,2"
                Height="32" MaxHeight="32" Visibility="Collapsed" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MaxWidth="540"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <visualization:VisualizerLegend x:Name="Legend" VerticalAlignment="Center"/>
                <visualization:VisualizerTrackOverview x:Name="TrackOverview" Grid.Column="1" Margin="6,0,0,0"
                                                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border x:Name="RecognitionOverlay" Grid.Row="1" Margin="0,20,0,0" Background="Transparent"
                VerticalAlignment="Top" Panel.ZIndex="10" IsHitTestVisible="False" Visibility="Collapsed">
            <common:MediaRecognitionProgressCard x:Name="RecognitionCard" HorizontalAlignment="Center" VerticalAlignment="Top"/>
        </Border>
    </Grid>
</UserControl>
