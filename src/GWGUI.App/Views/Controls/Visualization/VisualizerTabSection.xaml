<UserControl x:Class="GWGUI.App.Views.Controls.Visualization.VisualizerTabSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:visualization="clr-namespace:GWGUI.App.Views.Controls.Visualization"
             xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions">
    <Grid Margin="16" MinWidth="0" MinHeight="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <visualization:VisualizerHeaderSection x:Name="HeaderSection"/>

        <Grid x:Name="VisualizationArea" Grid.Row="1" Margin="0,10,0,8" MinWidth="0" MinHeight="240" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="InspectorSplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="InspectorColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource VisualizerSurface}" Padding="4" MinWidth="0" MinHeight="0">
            <Grid x:Name="MediaViewHost" MinWidth="0" MinHeight="0" ClipToBounds="True">
                <Grid x:Name="FluxViewHost">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <visualization:ScpDiskView x:Name="Side0" Margin="4"/>
                    <visualization:ScpDiskView x:Name="Side1" Grid.Column="1" Margin="4"/>
                </Grid>
            </Grid>
            </Border>

            <GridSplitter x:Name="InspectorSplitter"
                          Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Visibility="Collapsed"/>

            <Grid x:Name="InspectorHost"
                  Grid.Column="2"
                  Margin="8,4,4,4"
                  MinWidth="260"
                  MaxWidth="460"
                  MinHeight="0"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button x:Name="DetachInspectorButton"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,6"
                        Padding="8,3"
                        Style="{StaticResource VisualizerToolbarButton}"
                        Content="{l:Loc Visual.DetachInspector}"
                        AutomationProperties.Name="{l:Loc Visual.DetachInspector}"/>
                <visualization:MediaInspectorPanel x:Name="MediaInspector" Grid.Row="1"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource VisualizerSurface}" Padding="10,7" MaxHeight="180">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="True">
                    <Button x:Name="InspectorButton"
                            DockPanel.Dock="Right"
                            Content="{l:Loc Visual.Inspector}"
                            AutomationProperties.Name="{l:Loc Visual.Inspector}"
                            Style="{StaticResource VisualizerToolbarButton}"/>
                    <visualization:VisualizerLegend x:Name="Legend"/>
                </DockPanel>
                <visualization:VisualizerTrackOverview x:Name="TrackOverview" Grid.Row="1" Margin="0,6,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
