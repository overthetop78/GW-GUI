<UserControl x:Class="GWGUI.App.Views.Controls.Visualization.VisualizerTabSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:visualization="clr-namespace:GWGUI.App.Views.Controls.Visualization" xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <visualization:VisualizerHeaderSection x:Name="HeaderSection"/>
        <Grid x:Name="VisualizationArea" Grid.Row="1" ClipToBounds="True">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <visualization:ScpDiskView x:Name="Side0" Margin="4"/>
            <visualization:ScpDiskView x:Name="Side1" Grid.Column="1" Margin="4"/>
            <Canvas x:Name="InspectorLayer" Grid.ColumnSpan="2" Panel.ZIndex="10">
                <visualization:ScpInspectorPanel x:Name="InspectorPanel" Width="390" Height="410" Visibility="Collapsed"/>
            </Canvas>
        </Grid>
        <StackPanel Grid.Row="2" Margin="8,4">
            <DockPanel><Button x:Name="InspectorButton" DockPanel.Dock="Right" Content="{l:Loc Visual.Inspector}" Padding="8,2" MinHeight="24"/><visualization:VisualizerLegend/></DockPanel>
            <visualization:VisualizerTrackOverview x:Name="TrackOverview" Margin="0,6,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
