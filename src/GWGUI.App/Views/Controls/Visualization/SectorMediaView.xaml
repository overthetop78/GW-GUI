<UserControl x:Class="GWGUI.App.Views.Controls.Visualization.SectorMediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF">
    <UserControl.Resources>
        <Style x:Key="VisualizationZoomButton" TargetType="Button">
            <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="1"/>
            <Setter Property="Foreground" Value="#FF17242D"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFE7EEF3"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFD4E1EA"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectorSurface" TargetType="Border">
            <Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#EFF4F7"/>
            <Setter Property="CornerRadius" Value="8"/><Setter Property="ClipToBounds" Value="True"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="SurfacesGrid">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border x:Name="Side0Panel" Grid.Column="0" Style="{StaticResource SectorSurface}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border x:Name="Side0Header" Padding="9,6" Background="#EAF2F6F8">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Right" Padding="2" Background="#FAFFFFFF" BorderBrush="#FFB9C5CE" BorderThickness="1" CornerRadius="18">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource VisualizationZoomButton}" Tag="0" Content="&#x2212;" Click="ZoomOutButton_Click"/>
                                <Button x:Name="ResetZoom0Button" Style="{StaticResource VisualizationZoomButton}" Tag="0" Width="62" FontSize="12" Content="100 %" Click="ResetZoomButton_Click"/>
                                <Button Style="{StaticResource VisualizationZoomButton}" Tag="0" Content="+" Click="ZoomInButton_Click"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="Surface0Label" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Selection0Label" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <skia:SKElement x:Name="Canvas0" Grid.Row="1" Tag="0" PaintSurface="Canvas_PaintSurface" MouseLeftButtonDown="Canvas_MouseLeftButtonDown" MouseWheel="Canvas_MouseWheel"/>
            </Grid>
        </Border>

        <Border x:Name="Side1Panel" Grid.Column="1" Style="{StaticResource SectorSurface}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border x:Name="Side1Header" Padding="9,6" Background="#EAF2F6F8">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Right" Padding="2" Background="#FAFFFFFF" BorderBrush="#FFB9C5CE" BorderThickness="1" CornerRadius="18">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource VisualizationZoomButton}" Tag="1" Content="&#x2212;" Click="ZoomOutButton_Click"/>
                                <Button x:Name="ResetZoom1Button" Style="{StaticResource VisualizationZoomButton}" Tag="1" Width="62" FontSize="12" Content="100 %" Click="ResetZoomButton_Click"/>
                                <Button Style="{StaticResource VisualizationZoomButton}" Tag="1" Content="+" Click="ZoomInButton_Click"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="Surface1Label" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="Selection1Label" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <skia:SKElement x:Name="Canvas1" Grid.Row="1" Tag="1" PaintSurface="Canvas_PaintSurface" MouseLeftButtonDown="Canvas_MouseLeftButtonDown" MouseWheel="Canvas_MouseWheel"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
