<UserControl x:Class="GWGUI.App.Views.Controls.Visualization.SectorMediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource SubtlePanel}" Padding="8" Margin="4,4,4,6">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="32" Content="−" Click="ZoomOutButton_Click"/>
                    <Button x:Name="ResetZoomButton" MinWidth="58" Margin="4,0" Content="100 %" Click="ResetZoomButton_Click"/>
                    <Button Width="32" Content="+" Click="ZoomInButton_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{l:Loc Visual.SideLabel}"/>
                    <ComboBox x:Name="SurfaceSelector" MinWidth="120" SelectionChanged="SurfaceSelector_SelectionChanged"/>
                    <TextBlock x:Name="SelectionLabel"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Margin="4" Background="#090C10" CornerRadius="8" ClipToBounds="True">
            <skia:SKElement x:Name="Canvas"
                            PaintSurface="Canvas_PaintSurface"
                            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                            MouseWheel="Canvas_MouseWheel"/>
        </Border>
    </Grid>
</UserControl>
