<UserControl x:Class="GWGUI.App.Views.Controls.Visualization.BlockMediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions">
    <UserControl.Resources>
        <Style x:Key="VisualizationZoomButton" TargetType="Button">
            <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="1"/>
            <Setter Property="Foreground" Value="#FF17242D"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFE7EEF3"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFD4E1EA"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource SubtlePanel}" Margin="4,4,4,6" Padding="8">
            <DockPanel>
                <Border DockPanel.Dock="Right" Padding="2" Background="#FAFFFFFF"
                        BorderBrush="#FFB9C5CE" BorderThickness="1" CornerRadius="18">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ZoomOutButton" Style="{StaticResource VisualizationZoomButton}" Content="&#x2212;" Click="ZoomOutButton_Click"/>
                        <Button x:Name="ResetZoomButton" Style="{StaticResource VisualizationZoomButton}"
                                Width="62" FontSize="12" Content="100 %" Click="ResetZoomButton_Click"/>
                        <Button x:Name="ZoomInButton" Style="{StaticResource VisualizationZoomButton}" Content="+" Click="ZoomInButton_Click"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="SelectionLabel" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
            </DockPanel>
        </Border>
        <TabControl x:Name="ViewSelector" Grid.Row="1">
            <TabItem Header="{l:Loc Visual.LogicalMapTitle}">
                <Grid>
                    <Border Margin="4" Background="#090C10" CornerRadius="8" ClipToBounds="True">
                        <skia:SKElement x:Name="LogicalCanvas"
                                        PaintSurface="LogicalCanvas_PaintSurface"
                                        MouseLeftButtonDown="LogicalCanvas_MouseLeftButtonDown"
                                        MouseDown="Canvas_MouseDown"
                                        MouseUp="Canvas_MouseUp"
                                        MouseMove="Canvas_MouseMove"/>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem x:Name="GeometryTab" Header="{l:Loc Visual.ChsGeometryTitle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource SubtlePanel}" Margin="4" Padding="8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{l:Loc Visual.SurfaceLabel}"/>
                            <ComboBox x:Name="SurfaceSelector" MinWidth="130" SelectionChanged="SurfaceSelector_SelectionChanged"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Margin="4" Background="#090C10" CornerRadius="8" ClipToBounds="True">
                        <skia:SKElement x:Name="GeometryCanvas"
                                        PaintSurface="GeometryCanvas_PaintSurface"
                                        MouseLeftButtonDown="GeometryCanvas_MouseLeftButtonDown"
                                        MouseDown="Canvas_MouseDown"
                                        MouseUp="Canvas_MouseUp"
                                        MouseMove="Canvas_MouseMove"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
