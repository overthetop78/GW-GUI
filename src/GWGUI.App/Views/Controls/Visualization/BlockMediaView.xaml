<UserControl x:Class="GWGUI.App.Views.Controls.Visualization.BlockMediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource SubtlePanel}" Margin="4,4,4,6" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="32" Content="−" Click="ZoomOutButton_Click"/>
                    <Button x:Name="ResetZoomButton" MinWidth="58" Margin="4,0" Content="100 %" Click="ResetZoomButton_Click"/>
                    <Button Width="32" Content="+" Click="ZoomInButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="SelectionLabel" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
            </DockPanel>
        </Border>
        <TabControl x:Name="ViewSelector" Grid.Row="1">
            <TabItem Header="{l:Loc Visual.LogicalMapTitle}">
                <Grid>
                    <Border Margin="4" Background="#090C10" CornerRadius="8" ClipToBounds="True">
                        <skia:SKElement x:Name="LogicalCanvas"
                                        PaintSurface="LogicalCanvas_PaintSurface"
                                        MouseLeftButtonDown="LogicalCanvas_MouseLeftButtonDown"
                                        MouseDown="Canvas_MouseDown"
                                        MouseUp="Canvas_MouseUp"
                                        MouseMove="Canvas_MouseMove"/>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem x:Name="GeometryTab" Header="{l:Loc Visual.ChsGeometryTitle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource SubtlePanel}" Margin="4" Padding="8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{l:Loc Visual.SurfaceLabel}"/>
                            <ComboBox x:Name="SurfaceSelector" MinWidth="130" SelectionChanged="SurfaceSelector_SelectionChanged"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Margin="4" Background="#090C10" CornerRadius="8" ClipToBounds="True">
                        <skia:SKElement x:Name="GeometryCanvas"
                                        PaintSurface="GeometryCanvas_PaintSurface"
                                        MouseLeftButtonDown="GeometryCanvas_MouseLeftButtonDown"
                                        MouseDown="Canvas_MouseDown"
                                        MouseUp="Canvas_MouseUp"
                                        MouseMove="Canvas_MouseMove"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
