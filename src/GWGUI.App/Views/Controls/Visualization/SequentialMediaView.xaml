<UserControl x:Class="GWGUI.App.Views.Controls.Visualization.SequentialMediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions">
    <UserControl.Resources>
        <Style x:Key="SequentialZoomButton" TargetType="Button">
            <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="1"/>
            <Setter Property="Foreground" Value="#FF17242D"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFE7EEF3"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFD4E1EA"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource SubtlePanel}" Margin="4,4,4,6" Padding="8">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right" Padding="2" Background="#FFF9FBFC"
                        BorderBrush="#FFB9C5CE" BorderThickness="1" CornerRadius="17">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SequentialZoomButton}" Content="&#x2212;" Click="ZoomOutButton_Click"/>
                        <Button x:Name="ResetZoomButton" Style="{StaticResource SequentialZoomButton}"
                                Width="62" FontSize="13" Content="100 %" Click="ResetZoomButton_Click"/>
                        <Button Style="{StaticResource SequentialZoomButton}" Content="+" Click="ZoomInButton_Click"/>
                    </StackPanel>
                </Border>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock x:Name="FaceLabel" Margin="0,0,6,0" VerticalAlignment="Center" Text="{l:Loc Visual.SideLabel}"/>
                    <ComboBox x:Name="FaceSelector" MinWidth="100" Margin="0,0,10,0" SelectionChanged="FilterSelector_SelectionChanged"/>
                    <TextBlock x:Name="TrackLabel" Margin="0,0,6,0" VerticalAlignment="Center" Text="{l:Loc Visual.TrackLabel}"/>
                    <ComboBox x:Name="TrackSelector" MinWidth="100" Margin="0,0,10,0" SelectionChanged="FilterSelector_SelectionChanged"/>
                    <TextBlock x:Name="ChannelLabel" Margin="0,0,6,0" VerticalAlignment="Center" Text="{l:Loc Visual.ChannelLabel}"/>
                    <ComboBox x:Name="ChannelSelector" MinWidth="100" Margin="0,0,10,0" SelectionChanged="FilterSelector_SelectionChanged"/>
                    <TextBlock x:Name="SelectionLabel" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="TimelineScrollViewer"
                      Grid.Row="1"
                      Margin="4"
                      SizeChanged="TimelineScrollViewer_SizeChanged"
                      PreviewMouseWheel="TimelineScrollViewer_PreviewMouseWheel"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Hidden">
            <Border Background="#FF151A1F" CornerRadius="8" ClipToBounds="True">
                <skia:SKElement x:Name="Canvas"
                                MinWidth="640"
                                MinHeight="360"
                                PaintSurface="Canvas_PaintSurface"
                                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                MouseDown="Canvas_MouseDown"
                                MouseUp="Canvas_MouseUp"
                                MouseMove="Canvas_MouseMove"/>
            </Border>
        </ScrollViewer>

    </Grid>
</UserControl>
