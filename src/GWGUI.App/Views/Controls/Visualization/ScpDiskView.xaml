<UserControl x:Class="GWGUI.App.Views.Controls.Visualization.ScpDiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF">
    <UserControl.Resources>
        <Style x:Key="VisualizationZoomButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Foreground" Value="#FF17242D"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFE7EEF3"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFD4E1EA"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="#FFF4F7F9" CornerRadius="8" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="SurfaceHeader" Padding="9,6" Background="#EAF2F6F8">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Right" Padding="2" Background="#FAFFFFFF"
                            BorderBrush="#FFB9C5CE" BorderThickness="1" CornerRadius="18">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ZoomOutButton" Style="{StaticResource VisualizationZoomButton}" Content="&#x2212;" Click="ZoomOutButton_Click"/>
                            <Button x:Name="ResetZoomButton" Style="{StaticResource VisualizationZoomButton}" Width="62" FontSize="12"
                                    Content="100 %" Click="ResetZoomButton_Click"/>
                            <Button x:Name="ZoomInButton" Style="{StaticResource VisualizationZoomButton}" Content="+" Click="ZoomInButton_Click"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SurfaceLabel" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SelectionLabel" Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <skia:SKElement x:Name="Canvas" Grid.Row="1"
                            PaintSurface="Canvas_PaintSurface"
                            MouseWheel="Canvas_MouseWheel"
                            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                            MouseDown="Canvas_MouseDown"
                            MouseUp="Canvas_MouseUp"
                            MouseMove="Canvas_MouseMove"/>
        </Grid>
    </Border>
</UserControl>
