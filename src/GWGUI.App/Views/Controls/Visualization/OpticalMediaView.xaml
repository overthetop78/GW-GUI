<UserControl x:Class="GWGUI.App.Views.Controls.Visualization.OpticalMediaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource SubtlePanel}" Margin="4,4,4,6" Padding="8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="32" Content="−" Click="ZoomOutButton_Click"/>
                    <Button x:Name="ResetZoomButton" MinWidth="58" Margin="4,0" Content="100 %" Click="ResetZoomButton_Click"/>
                    <Button Width="32" Content="+" Click="ZoomInButton_Click"/>
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="{l:Loc Visual.SideLabel}"/>
                    <ComboBox x:Name="FaceSelector" MinWidth="105" Margin="0,0,10,0" SelectionChanged="FilterSelector_SelectionChanged"/>
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="{l:Loc Visual.LayerLabel}"/>
                    <ComboBox x:Name="LayerSelector" MinWidth="105" Margin="0,0,10,0" SelectionChanged="FilterSelector_SelectionChanged"/>
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="{l:Loc Visual.SessionLabel}"/>
                    <ComboBox x:Name="SessionSelector" MinWidth="105" Margin="0,0,10,0" SelectionChanged="FilterSelector_SelectionChanged"/>
                    <TextBlock x:Name="SelectionLabel" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Margin="4" Background="#090C10" CornerRadius="8" ClipToBounds="True">
            <skia:SKElement x:Name="Canvas"
                            PaintSurface="Canvas_PaintSurface"
                            MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                            MouseDown="Canvas_MouseDown"
                            MouseUp="Canvas_MouseUp"
                            MouseMove="Canvas_MouseMove"
                            MouseWheel="Canvas_MouseWheel"/>
        </Border>
    </Grid>
</UserControl>
