<UserControl x:Class="GWGUI.App.Views.Controls.Common.MediaRecognitionProgressCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Width="540" Padding="28,24" CornerRadius="12" Background="White"
            BorderBrush="#FFD6E0E6" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="42" Height="42" CornerRadius="21" Background="#FFE4F1E9" VerticalAlignment="Top">
                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFontFamily}" FontSize="20" Foreground="#FF247A47"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="StageText" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="DetailText" Margin="0,4,0,14" Foreground="{DynamicResource MutedTextBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <Grid Height="8" ClipToBounds="True">
                    <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" Value="0" IsIndeterminate="False"/>
                    <Border Width="80" HorizontalAlignment="Left" Opacity="0.32" CornerRadius="4">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform><TranslateTransform X="-90"/></Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="-90" To="470" Duration="0:0:1.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                </Grid>
                <TextBlock x:Name="PercentText" Text="0 %" Margin="0,7,0,0" FontSize="11" FontWeight="SemiBold"
                           Foreground="#FF247A47" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
