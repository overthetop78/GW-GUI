<UserControl x:Class="GWGUI.App.Views.Controls.Common.FileEntryIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="20" Height="20" IsHitTestVisible="False">
    <Grid>
        <Path x:Name="FolderIcon" Visibility="Collapsed" Fill="#E4AE35" Stroke="#A97716" StrokeThickness="0.8"
              Data="M2,5 L8,5 L10,8 L18,8 L18,17 L2,17 Z M2,5 L8,5 L10,8 L2,8 Z"/>
        <Grid x:Name="FileIcon" Visibility="Collapsed">
            <Path Fill="#F7F8FA" Stroke="#727985" StrokeThickness="1" Data="M4,1 L12,1 L17,6 L17,19 L4,19 Z"/>
            <Path Fill="#DDE3EA" Stroke="#727985" StrokeThickness="0.7" Data="M12,1 L12,6 L17,6 Z"/>
            <Path x:Name="TypeMark" Fill="#6B7482" Stretch="Uniform" Width="10" Height="8" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
        </Grid>
        <Path x:Name="LinkMark" Visibility="Collapsed" Stroke="#64748B" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              Data="M7,13 C4,16 1,13 3,10 L6,7 M13,7 C16,4 19,7 17,10 L14,13 M7,12 L13,8"/>
    </Grid>
</UserControl>
