<UserControl x:Class="GWGUI.App.Views.Controls.Common.MediaDocumentIdentity"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid HorizontalAlignment="Left">
        <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border x:Name="IconTile" Width="40" Height="40" CornerRadius="8" Background="#FFE4EDF5"
                HorizontalAlignment="Left" VerticalAlignment="Center">
            <Grid>
                <Image x:Name="IconImage" Width="38" Height="38" Stretch="Uniform" Visibility="Collapsed"
                       RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                <Viewbox x:Name="IconVector" Width="25" Height="25">
                    <Path x:Name="Icon" Width="24" Height="24" Stretch="Uniform" Fill="#FF24658A"/>
                </Viewbox>
            </Grid>
        </Border>
        <Grid Grid.Column="1" MaxWidth="640" VerticalAlignment="Center">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="FileName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="Summary" Grid.Row="1" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Grid>
</UserControl>
