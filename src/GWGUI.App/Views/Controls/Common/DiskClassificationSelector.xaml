<UserControl x:Class="GWGUI.App.Views.Controls.Common.DiskClassificationSelector" x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions">
    <Grid VerticalAlignment="Bottom">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <CheckBox x:Name="Automatic" Content="{l:Loc Classification.Automatic}" IsChecked="True"
                  VerticalAlignment="Bottom" Height="38" Margin="0,0,14,0" Checked="Automatic_Changed" Unchecked="Automatic_Changed"/>
        <StackPanel Grid.Column="1" Margin="0,0,12,0">
            <TextBlock Text="{l:Loc Classification.Machine}" Margin="0,0,0,5"/>
            <ComboBox x:Name="Machine" Height="38" VerticalContentAlignment="Center" SelectionChanged="Machine_Changed" AutomationProperties.Name="{l:Loc Classification.Machine}">
                <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="#2EA866"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Opacity" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsDetected}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Normal"/><Style.Triggers><DataTrigger Binding="{Binding IsDetected}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="0,0,12,0">
            <TextBlock Text="{l:Loc Classification.Format}" Margin="0,0,0,5"/>
            <ComboBox x:Name="Format" Height="38" VerticalContentAlignment="Center" SelectionChanged="Format_Changed" AutomationProperties.Name="{l:Loc Classification.Format}">
                <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="#2EA866"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Opacity" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsDetected}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Normal"/><Style.Triggers><DataTrigger Binding="{Binding IsDetected}" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <StackPanel x:Name="ProtectionPanel" Grid.Column="3" Width="200" Visibility="Collapsed">
            <TextBlock Text="{l:Loc Classification.Protection}" Margin="0,0,0,5"/>
            <ComboBox x:Name="Protection" Height="38" VerticalContentAlignment="Center" DisplayMemberPath="DisplayName" SelectionChanged="Protection_Changed" AutomationProperties.Name="{l:Loc Classification.Protection}"/>
        </StackPanel>
    </Grid>
</UserControl>
