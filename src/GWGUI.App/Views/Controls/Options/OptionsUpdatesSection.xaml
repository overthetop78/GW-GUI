<UserControl x:Class="GWGUI.App.Views.Controls.Options.OptionsUpdatesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions">
    <UserControl.Resources>
        <DataTemplate x:Key="UpdateComponentTemplate">
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding InstalledLabel}"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding Versions}"
                              SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                              IsEnabled="{Binding CanSelectVersion}"
                              SelectionChanged="Version_SelectionChanged"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding StatusLabel}"
                               Margin="0,7,0,0" Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{l:Loc Updates.Description}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <GroupBox Grid.Row="1" Header="{l:Loc Updates.Application}" Margin="0,0,0,12">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SearchAction" Content="{l:Loc Updates.Search}" Click="Search_Click"/>
                    <Button x:Name="InstallAction" Content="{l:Loc Updates.Install}" Margin="10,0,0,0"
                            IsEnabled="False" Click="Install_Click"/>
                    <Button x:Name="CancelAction" Content="{l:Loc Common.Cancel}" Margin="10,0,0,0"
                            Visibility="Collapsed" Click="Cancel_Click"/>
                </StackPanel>
                <TextBlock x:Name="SearchStatus" Margin="0,12" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}"/>
                <ProgressBar x:Name="PreparationProgress" Height="4" Margin="0,0,0,12"
                             Minimum="0" Maximum="100" Visibility="Collapsed"/>
                <ItemsControl x:Name="ResultsList" ItemTemplate="{StaticResource UpdateComponentTemplate}"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="{l:Loc Updates.ScopeModules}">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SearchModulesAction" Content="{l:Loc Updates.Search}" Click="SearchModules_Click"/>
                    <Button x:Name="InstallModulesAction" Content="{l:Loc Updates.Install}" Margin="10,0,0,0"
                            IsEnabled="False" Click="InstallModules_Click"/>
                    <Button x:Name="CancelModulesAction" Content="{l:Loc Common.Cancel}" Margin="10,0,0,0"
                            Visibility="Collapsed" Click="CancelModules_Click"/>
                </StackPanel>
                <Separator Margin="0,12"/>
                <TextBlock Text="{l:Loc Updates.ModuleInstallDescription}" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="InstallModuleFileAction" Content="{l:Loc Updates.ModuleInstallFromFile}"
                            Click="InstallModuleFile_Click"/>
                    <TextBox x:Name="ModuleCatalogUrlInput" Width="360" Margin="10,0,0,0"
                             ToolTip="{l:Loc Updates.ModuleCatalogUrlHint}"/>
                    <Button x:Name="InstallModuleUrlAction" Content="{l:Loc Updates.ModuleInstallFromUrl}"
                            Margin="10,0,0,0" Click="InstallModuleUrl_Click"/>
                </StackPanel>
                <TextBlock x:Name="ModulesStatus" Margin="0,12" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}"/>
                <ProgressBar x:Name="ModulesPreparationProgress" Height="4" Margin="0,0,0,12"
                             Minimum="0" Maximum="100" Visibility="Collapsed"/>
                <ItemsControl x:Name="ModulesResultsList" ItemTemplate="{StaticResource UpdateComponentTemplate}"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
