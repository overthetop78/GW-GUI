<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GWGUI.App.Views.Controls.Options.OptionsUpdatesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Text="{l:Loc Updates.Description}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBlock Text="{l:Loc Updates.Scope}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="ScopeSelector" Width="220" DisplayMemberPath="Label" SelectedValuePath="Scope"/>
            <Button x:Name="SearchAction" Content="{l:Loc Updates.Search}" Margin="10,0,0,0" Click="Search_Click"/>
            <Button x:Name="InstallAction" Content="{l:Loc Updates.Install}" Margin="10,0,0,0" IsEnabled="False" Click="Install_Click"/>
            <Button x:Name="CancelAction" Content="{l:Loc Common.Cancel}" Margin="10,0,0,0" Visibility="Collapsed" Click="Cancel_Click"/>
        </StackPanel>
        <TextBlock x:Name="SearchStatus" Grid.Row="2" Margin="0,12" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedTextBrush}"/>
        <ProgressBar x:Name="PreparationProgress" Grid.Row="2" Height="4" Margin="0,37,0,0"
                     Minimum="0" Maximum="100" Visibility="Collapsed"/>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ResultsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding InstalledLabel}"/>
                                <ComboBox Grid.Column="2" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                          IsEnabled="{Binding CanSelectVersion}" SelectionChanged="Version_SelectionChanged"/>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding StatusLabel}" Margin="0,7,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
