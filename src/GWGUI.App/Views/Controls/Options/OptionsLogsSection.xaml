<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GWGUI.App.Views.Controls.Options.OptionsLogsSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{l:Loc Options.LogsDescription}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="LogOptionsList"><ItemsControl.ItemTemplate><DataTemplate>
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="210"/><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" Content="{l:Loc Options.EnableLogs}" IsChecked="{Binding Settings.Enabled, Mode=TwoWay}" VerticalAlignment="Center" Click="LogRow_Changed"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{l:Loc Options.LogMaximumSize}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox Width="72" Text="{Binding Settings.MaximumKilobytes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" VerticalContentAlignment="Center" LostKeyboardFocus="LogRowMaximumSize_LostKeyboardFocus" PreviewTextInput="NumericText_PreviewTextInput"/><TextBlock Text="{l:Loc Options.Kilobytes}" VerticalAlignment="Center" Margin="7,0,0,0"/></StackPanel>
                    <CheckBox Grid.Column="3" Content="{l:Loc Options.KeepLogArchives}" IsChecked="{Binding Settings.KeepArchives, Mode=TwoWay}" VerticalAlignment="Center" Click="LogRow_Changed"/>
                </Grid></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{l:Loc Options.LogUnlimitedHint}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock x:Name="LogsDirectoryText" VerticalAlignment="Center" Margin="0,0,10,0"/><Button Content="{l:Loc Options.OpenLogsFolder}" Click="OpenLogsFolder_Click"/></StackPanel></Grid>
    </Grid>
</UserControl>
