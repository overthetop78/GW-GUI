<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GWGUI.App.Views.Controls.Options.OptionsHardwareSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" xmlns:local="clr-namespace:GWGUI.App.Dictionaries.Options">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel><Button x:Name="ScanButton" Content="{l:Loc Hardware.Scan}" Click="ScanHardware_Click"/><Button x:Name="AddDriveButton" Content="{l:Loc Hardware.AddDrive}" Click="AddDrive_Click"/></WrapPanel>
        <ListBox Grid.Row="1" x:Name="DrivesGrid" MaxHeight="230" Margin="0,10,0,6" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{l:Loc Options.Hardware}">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="100"/><ColumnDefinition Width="150"/><ColumnDefinition Width="165"/><ColumnDefinition Width="175"/><ColumnDefinition/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Port}" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding ReaderLabel}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{l:Loc Hardware.SizeShort}" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox Width="68" ItemsSource="{x:Static local:HardwareChoices.Sizes}" SelectedItem="{Binding Size, Mode=TwoWay}"/></StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{l:Loc Hardware.DensityShort}" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox Width="88" ItemsSource="{x:Static local:HardwareChoices.Densities}" SelectedItem="{Binding Density, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding}"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="Unknown"><Setter Property="Text" Value="{l:Loc Common.Unknown}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{l:Loc Hardware.SpeedShort}" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox Width="98" ItemsSource="{x:Static local:HardwareChoices.Speeds}" SelectedItem="{Binding Rpm, Mode=TwoWay}"/></StackPanel>
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="9" Height="9" Margin="0,0,6,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#858B96"/><Style.Triggers><DataTrigger Binding="{Binding Available}" Value="True"><Setter Property="Fill" Value="#32A852"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding AvailabilityState}" VerticalAlignment="Center" Margin="0,0,12,0"/><Border Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,3"><TextBlock Text="{Binding ConfigurationState}" VerticalAlignment="Center"/></Border></StackPanel>
                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="{l:Loc Common.SaveIcon}" ToolTip="{l:Loc Common.Save}" AutomationProperties.Name="{l:Loc Common.Save}" Click="SaveHardwareRow_Click" Padding="7,3" Margin="2"/><Button Content="{l:Loc Common.TrashIcon}" Foreground="#D73535" ToolTip="{l:Loc Hardware.Forget}" AutomationProperties.Name="{l:Loc Hardware.Forget}" Click="ForgetHardwareRow_Click" Padding="7,3" Margin="2"/></StackPanel>
            </Grid></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Text="{l:Loc Options.HardwarePersistence}" Margin="0,0,0,14"/>
        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{l:Loc Options.GwPath}"/><TextBox x:Name="GwPathText" Margin="0,6,8,0" LostKeyboardFocus="AutoSaveText_LostKeyboardFocus" AutomationProperties.Name="{l:Loc Options.GwPath}"/></StackPanel><Button Grid.Column="1" VerticalAlignment="Bottom" Content="{l:Loc Common.Choose}" Click="BrowseGw_Click"/></Grid>
        <StackPanel Grid.Row="4"><WrapPanel Margin="0,10,0,0"><Button Content="{l:Loc HostTools.Detect}" Click="DetectHostTools_Click"/><Button Content="{l:Loc HostTools.Check}" Click="CheckHostTools_Click"/><Button x:Name="DownloadHostToolsButton" Content="{l:Loc HostTools.Download}" Click="DownloadHostTools_Click"/><Button Content="{l:Loc HostTools.Rollback}" Click="RollbackHostTools_Click"/></WrapPanel><ProgressBar x:Name="HostToolsProgress" Height="8" Margin="4,8" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.Name="{l:Loc HostTools.Download}"/><TextBlock x:Name="HostToolsStatus" Margin="4,4" TextWrapping="Wrap"/></StackPanel>
    </Grid>
</UserControl>
