<UserControl x:Class="GWGUI.App.Views.Controls.Write.WriteFormatSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" xmlns:common="clr-namespace:GWGUI.App.Views.Controls.Common">
    <common:CardSection>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="VisualizeTracks" Content="{l:Loc Write.VisualizeTracks}" IsEnabled="False"/>
                    <Button x:Name="Modify" Content="{l:Loc Common.Modify}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{l:Loc Write.Detected}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Detection" Text="{l:Loc Write.ChooseImage}" Margin="0,5,12,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
            <ComboBox Grid.Row="1" x:Name="Formats" Margin="0,12,0,0" Visibility="Collapsed" DisplayMemberPath="DisplayName" AutomationProperties.Name="{l:Loc Write.Detected}"/>
        </Grid>
    </common:CardSection>
</UserControl>
