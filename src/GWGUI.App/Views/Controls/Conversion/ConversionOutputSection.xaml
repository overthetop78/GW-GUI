<UserControl x:Class="GWGUI.App.Views.Controls.Conversion.ConversionOutputSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" xmlns:common="clr-namespace:GWGUI.App.Views.Controls.Common">
    <common:CardSection>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="330"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="{l:Loc Conversion.OutputNames}" VerticalAlignment="Center"/>
            <TextBox x:Name="OutputName" Grid.Column="1" Margin="12,0" VerticalContentAlignment="Center" Text="{Binding Conversion.OutputName, UpdateSourceTrigger=PropertyChanged}" TextChanged="Value_Changed" AutomationProperties.Name="{l:Loc Conversion.OutputNames}"/>
            <CheckBox x:Name="Tags" Grid.Column="2" IsChecked="{Binding Conversion.AddTags, Mode=TwoWay}" Content="{l:Loc Conversion.AddTags}" VerticalAlignment="Center" Checked="Value_Changed" Unchecked="Value_Changed"/>
            <TextBlock x:Name="SourceInfo" Grid.Column="3" Margin="18,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Grid>
    </common:CardSection>
</UserControl>
