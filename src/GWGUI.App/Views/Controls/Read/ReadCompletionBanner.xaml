<UserControl x:Class="GWGUI.App.Views.Controls.Read.ReadCompletionBanner" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" Visibility="Collapsed">
    <Border Background="#E7F0FF" BorderBrush="#4D76E8" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ExploreButton" Content="{l:Loc Read.OpenExplore}" Margin="0,0,8,0"/>
                <Button x:Name="VisualizeButton" Content="{l:Loc Read.OpenVisualize}"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="{l:Loc Read.ScpFinished}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="SummaryText" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
