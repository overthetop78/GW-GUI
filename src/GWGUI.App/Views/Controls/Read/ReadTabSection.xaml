<UserControl x:Class="GWGUI.App.Views.Controls.Read.ReadTabSection" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="clr-namespace:GWGUI.App.Views.Controls.Common" xmlns:read="clr-namespace:GWGUI.App.Views.Controls.Read" xmlns:options="clr-namespace:GWGUI.App.Views.Controls.Options" xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
                    <read:ReadImageSection x:Name="ImageSection" Margin="0,0,6,12"/>
                    <options:ProfileSection x:Name="ProfileSection" Grid.Column="1" Margin="6,0,0,12"/>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                    <common:PathSection x:Name="FolderSection" Label="{l:Loc Read.Folder}" Text="{Binding Read.Folder, Mode=TwoWay}" Margin="0,0,6,12"/>
                    <read:ReadFileNameSection x:Name="FileNameSection" Grid.Column="1" Margin="6,0,0,12"/>
                </Grid>
                <read:ReadAdvancedSection x:Name="AdvancedSection" Grid.Row="0"/>
                <read:ReadCompletionBanner Grid.Row="5" x:Name="CompletionBanner"/>
            </Grid>
        </ScrollViewer>
        <Button Grid.Row="1" x:Name="ExecuteButton" Content="{l:Loc Common.Execute}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="16,4,16,12" AutomationProperties.AutomationId="ReadExecuteButton"/>
    </Grid>
</UserControl>
