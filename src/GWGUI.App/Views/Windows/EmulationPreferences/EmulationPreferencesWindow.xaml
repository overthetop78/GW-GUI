<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GWGUI.App.Views.Windows.EmulationPreferences.EmulationPreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions"
        xmlns:emulationOptions="clr-namespace:GWGUI.App.Views.Controls.Emulation.Options"
        ShowInTaskbar="False" Title="{l:Loc Options.EmulationTitle}"
        Width="1220" Height="760" MinWidth="1020" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <emulationOptions:EmulationPreferencesSection x:Name="EmulationSection"/>
        <Button Grid.Row="1" HorizontalAlignment="Right" Margin="0,12,0,0" MinWidth="120"
                Content="{l:Loc Common.Close}" IsDefault="True" Click="Close_Click"/>
    </Grid>
</Window>

