<Window ShowInTaskbar="False"  x:Class="GWGUI.App.Views.Windows.Conversion.FileMigrationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions" Title="{l:Loc Migration.Title}" Width="900" Height="650" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{l:Loc Migration.Heading}" FontSize="22" FontWeight="SemiBold"/>
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{l:Loc Migration.Source}" FontWeight="SemiBold"/>
                <TextBox x:Name="SourcePathTextBox" Margin="0,5,10,0" IsReadOnly="True" AutomationProperties.Name="{l:Loc Migration.Source}"/>
            </StackPanel>
            <Button x:Name="BrowseSourceButton" Grid.Column="1" Content="{l:Loc Common.Browse}" VerticalAlignment="Bottom"/>
        </Grid>
        <TextBlock x:Name="SourceSummaryText" Grid.Row="2" Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" Text="{l:Loc Migration.NoSource}"/>
        <Grid Grid.Row="3" Margin="0,16,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{l:Loc Migration.Destination}" FontWeight="SemiBold"/>
                <ComboBox x:Name="TargetComboBox" Margin="0,5,10,0" ItemsSource="{Binding Targets}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedTarget}" AutomationProperties.Name="{l:Loc Migration.Destination}"/>
                <TextBlock Text="{l:Loc Migration.Output}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                <TextBox x:Name="OutputPathTextBox" Margin="0,5,10,0" IsReadOnly="True" AutomationProperties.Name="{l:Loc Migration.Output}"/>
            </StackPanel>
            <Button x:Name="BrowseOutputButton" Grid.Column="1" Content="{l:Loc Common.Browse}" VerticalAlignment="Bottom"/>
        </Grid>
        <GroupBox Grid.Row="4" Header="{l:Loc Migration.Compatibility}">
            <Grid Margin="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="CompatibilityText" FontWeight="SemiBold" Text="{l:Loc Migration.Waiting}"/>
                <ListView x:Name="LossesList" Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding Losses}" AutomationProperties.Name="{l:Loc Migration.Compatibility}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{l:Loc Migration.Severity}" DisplayMemberBinding="{Binding Severity}" Width="150"/>
                            <GridViewColumn Header="{l:Loc Migration.Path}" DisplayMemberBinding="{Binding Path}" Width="260"/>
                            <GridViewColumn Header="{l:Loc Migration.Description}" DisplayMemberBinding="{Binding Description}" Width="360"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <CheckBox x:Name="AcceptLossesCheckBox" Grid.Row="2" Margin="0,10,0,0" Content="{l:Loc Migration.AcceptLosses}"/>
            </Grid>
        </GroupBox>
        <DockPanel Grid.Row="5" Margin="0,16,0,0">
            <ProgressBar x:Name="ProgressBar" Width="180" Height="4" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="{l:Loc Common.Close}" IsCancel="True"/>
                <Button x:Name="ExecuteButton" Content="{l:Loc Migration.Execute}" IsDefault="True" Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
