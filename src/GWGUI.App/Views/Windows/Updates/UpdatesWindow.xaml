<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GWGUI.App.Views.Windows.Updates.UpdatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions"
        xmlns:options="clr-namespace:GWGUI.App.Views.Controls.Options"
        ShowInTaskbar="False" Title="{l:Loc Updates.Title}"
        Width="1120" Height="720" MinWidth="920" MinHeight="580"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="4,0,4,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource SelectedBrush}">
                <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{l:Loc Updates.Title}" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="{l:Loc Updates.Description}" Margin="0,4,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
        <options:OptionsUpdatesSection x:Name="UpdatesSection" Grid.Row="1"/>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="FinishInstallationHint" HorizontalAlignment="Right" Margin="0,0,0,8"
                       Text="{l:Loc Updates.FinishModuleInstallationsHint}" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" Visibility="Collapsed"/>
            <Button x:Name="FooterAction" HorizontalAlignment="Right" MinWidth="120"
                    IsDefault="True" Click="FooterAction_Click"/>
        </StackPanel>
    </Grid>
</Window>
