<Window ShowInTaskbar="False"  x:Class="GWGUI.App.Views.Windows.About.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions"
        Title="{l:Loc Menu.About}" Width="820" Height="610"
        MinWidth="820" MinHeight="610" MaxWidth="820" MaxHeight="610"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="96" Height="96" CornerRadius="20" Background="#F2F6FA">
                <Image Source="Assets/app-icon.png" Width="82" Height="82" AutomationProperties.Name="{l:Loc App.Title}"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="24,2,0,0" VerticalAlignment="Center">
                <TextBlock Text="{l:Loc App.Title}" FontSize="32" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" FontSize="15" Margin="0,3,0,10" Foreground="#5E6B78"/>
                <TextBlock Text="{l:Loc About.Description}" TextWrapping="Wrap" FontSize="14"/>
                <TextBlock Text="{l:Loc About.License}" Margin="0,8,0,0" Foreground="#5E6B78"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Height="1" Background="#D9E0E7" Margin="0,22,0,18"/>
        <Border Grid.Row="2" Background="#F6F8FA" BorderBrush="#D9E0E7" BorderThickness="1" CornerRadius="12" Padding="20,16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="{l:Loc About.Components}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <ItemsControl x:Name="ComponentVersions" Grid.Row="1">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Background="White" BorderBrush="#E1E6EB" BorderThickness="1" CornerRadius="7" Margin="0,0,10,10" Padding="12,8">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Version}" FontFamily="Consolas" Foreground="#435160" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
        <Button Grid.Row="3" Content="{l:Loc Common.Close}" IsCancel="True" HorizontalAlignment="Right" Margin="0,18,0,0" MinWidth="104"/>
    </Grid>
</Window>
