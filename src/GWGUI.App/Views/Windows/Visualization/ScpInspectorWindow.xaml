<Window x:Class="GWGUI.App.Views.Windows.Visualization.ScpInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:visualization="clr-namespace:GWGUI.App.Views.Controls.Visualization"
        xmlns:l="clr-namespace:GWGUI.App.Localization.Extensions"
        Title="{l:Loc Visual.Title}"
        Width="460"
        Height="560"
        MinWidth="380"
        MinHeight="400"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <visualization:MediaInspectorPanel x:Name="Inspector"/>

        <StackPanel Grid.Row="1"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button x:Name="AttachButton"
                    MinWidth="110"
                    Margin="0,0,8,0"
                    Content="{l:Loc Visual.AttachInspector}"
                    Click="AttachButton_Click"/>
            <Button MinWidth="90"
                    Content="{l:Loc Common.Close}"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
