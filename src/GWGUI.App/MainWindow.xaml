<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GWGUI.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GWGUI.App" xmlns:l="clr-namespace:GWGUI.App.Localization" Title="{l:Loc App.Title}" MinWidth="1280" MinHeight="720" Width="1360" Height="820" WindowStartupLocation="CenterScreen" Closing="Window_Closing" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="ConsoleRow" Height="190" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Menu>
            <MenuItem Header="{l:Loc Menu.Options}">
                <MenuItem Header="{l:Loc Menu.Preferences}" Click="Preferences_Click" />
                <Separator />
                <MenuItem Header="{l:Loc Menu.Diagnostics}">
                    <MenuItem Header="{l:Loc Menu.Information}" Tag="info" Click="ToolCommand_Click" />
                    <MenuItem Header="{l:Loc Menu.Bandwidth}" Tag="bandwidth" Click="ToolCommand_Click" />
                    <MenuItem Header="{l:Loc Menu.Rpm}" Tag="rpm" Click="ToolCommand_Click" />
                    <MenuItem Header="{l:Loc Menu.Seek}" Tag="seek" Click="ToolCommand_Click" />
                </MenuItem>
                <MenuItem Header="{l:Loc Menu.Hardware}">
                    <MenuItem Header="{l:Loc Menu.Pins}" Tag="pin" Click="ToolCommand_Click" />
                    <MenuItem Header="{l:Loc Menu.Reset}" Tag="reset" Click="ToolCommand_Click" />
                    <MenuItem Header="{l:Loc Menu.Delays}" Tag="delays" Click="ToolCommand_Click" />
                    <Separator />
                    <MenuItem Header="{l:Loc Menu.Firmware}" Tag="update" Click="ToolCommand_Click" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{l:Loc Menu.Help}">
                <MenuItem Header="{l:Loc Menu.Documentation}" />
                <MenuItem Header="{l:Loc Menu.About}" />
            </MenuItem>
        </Menu>
        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="16,10,16,0" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="{l:Loc Tab.Read}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="{l:Loc Common.Save}" Click="SaveReadProfile_Click" />
                                    <Button Content="{l:Loc Common.Reset}" Click="ResetReadProfile_Click" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{l:Loc Common.Profile}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ComboBox x:Name="ReadProfileCombo" Width="260" DisplayMemberPath="Name" SelectionChanged="ReadProfile_Changed" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Read.ImageToCreate}" FontWeight="SemiBold" />
                                <RadioButton x:Name="RawScpRadio" Content="{l:Loc Read.RawScp}" IsChecked="True" Margin="0,10,0,4" Checked="ReadMode_Changed" />
                                <RadioButton x:Name="KnownFormatRadio" Content="{l:Loc Read.KnownFormat}" Margin="0,4" Checked="ReadMode_Changed" />
                                <Grid x:Name="KnownFormatPanel" Visibility="Collapsed" Margin="24,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ReadFamilyCombo" Margin="0,0,8,0" SelectionChanged="ReadFamily_Changed" />
                                    <ComboBox x:Name="ReadFormatCombo" Grid.Column="1" Margin="0,0,8,0" DisplayMemberPath="DisplayName" SelectionChanged="ReadFormat_Changed" />
                                    <ComboBox x:Name="ReadExtensionCombo" Grid.Column="2" DisplayMemberPath="DisplayName" SelectionChanged="ReadInput_Changed" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l:Loc Read.FileName}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Column="1" x:Name="ReadFileName" TextChanged="ReadInput_Changed" />
                                <TextBox Grid.Column="2" x:Name="ReadExtensionText" Margin="8,0" IsReadOnly="True" Text="{l:Loc Read.RawScp}" />
                                <Button Grid.Column="3" Content="{l:Loc Common.Copy}" Click="CopyReadName_Click" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="3" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l:Loc Read.Folder}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Column="1" x:Name="ReadFolder" IsReadOnly="True" />
                                <Button Grid.Column="2" Content="{l:Loc Common.Browse}" Click="BrowseReadFolder_Click" />
                            </Grid>
                        </Border>
                        <Expander Grid.Row="4" Header="{l:Loc Common.Advanced}">
                            <Border Style="{StaticResource Card}" Margin="0,10,0,12">
                                <StackPanel>
                                    <WrapPanel>
                                        <CheckBox x:Name="ReadRevsEnabled" Content="{l:Loc Read.Revolutions}" Margin="8" Checked="ReadInput_Changed" Unchecked="ReadInput_Changed" />
                                        <TextBox x:Name="ReadRevsValue" Width="70" Text="5" TextChanged="ReadInput_Changed" />
                                        <CheckBox x:Name="ReadRetriesEnabled" Content="{l:Loc Read.Retries}" Margin="18,8,8,8" Checked="ReadInput_Changed" Unchecked="ReadInput_Changed" />
                                        <TextBox x:Name="ReadRetriesValue" Width="70" Text="5" TextChanged="ReadInput_Changed" />
                                        <CheckBox x:Name="ReadTracksEnabled" Content="{l:Loc Read.Tracks}" Margin="18,8,8,8" Checked="ReadInput_Changed" Unchecked="ReadInput_Changed" />
                                        <TextBox x:Name="ReadTracksValue" Width="190" Text="c=0-79:h=0-1" TextChanged="ReadInput_Changed" />
                                    </WrapPanel>
                                    <WrapPanel>
                                        <CheckBox x:Name="ReadSeekRetriesEnabled" Content="{l:Loc Advanced.SeekRetries}" Margin="8" Checked="ReadInput_Changed" Unchecked="ReadInput_Changed" />
                                        <TextBox x:Name="ReadSeekRetriesValue" Width="70" Text="0" TextChanged="ReadInput_Changed" />
                                        <CheckBox x:Name="ReadFakeIndexEnabled" Content="{l:Loc Advanced.FakeIndex}" Margin="18,8,8,8" Checked="ReadFakeIndex_Checked" Unchecked="ReadInput_Changed" />
                                        <TextBox x:Name="ReadFakeIndexValue" Width="90" Text="300rpm" TextChanged="ReadInput_Changed" />
                                        <CheckBox x:Name="ReadHardSectors" Content="{l:Loc Advanced.HardSectors}" Margin="18,8" Checked="ReadHardSectors_Checked" Unchecked="ReadInput_Changed" />
                                        <CheckBox x:Name="ReadReverse" Content="{l:Loc Advanced.Reverse}" Margin="8" Checked="ReadInput_Changed" Unchecked="ReadInput_Changed" />
                                    </WrapPanel>
                                    <WrapPanel>
                                        <CheckBox x:Name="ReadAdjustSpeedEnabled" Content="{l:Loc Advanced.AdjustSpeed}" Margin="8" Checked="ReadInput_Changed" Unchecked="ReadInput_Changed" />
                                        <TextBox x:Name="ReadAdjustSpeedValue" Width="90" Text="300rpm" TextChanged="ReadInput_Changed" />
                                        <CheckBox x:Name="ReadPllEnabled" Content="{l:Loc Advanced.Pll}" Margin="18,8,8,8" Checked="ReadInput_Changed" Unchecked="ReadInput_Changed" />
                                        <TextBox x:Name="ReadPllValue" Width="180" Text="period=5:phase=60" TextChanged="ReadInput_Changed" />
                                        <CheckBox x:Name="ReadDenselEnabled" Content="{l:Loc Advanced.DensityPin}" Margin="18,8,8,8" Checked="ReadDensel_Checked" Unchecked="ReadInput_Changed" />
                                        <ComboBox x:Name="ReadDenselValue" Width="70" SelectedIndex="0" SelectionChanged="ReadInput_Changed"><ComboBoxItem Content="H"/><ComboBoxItem Content="L"/></ComboBox>
                                        <CheckBox x:Name="ReadTg43" Content="{l:Loc Advanced.Tg43}" Margin="18,8" Checked="ReadTg43_Checked" Unchecked="ReadInput_Changed" />
                                    </WrapPanel>
                                    <Separator Margin="8" />
                                    <WrapPanel>
                                        <CheckBox x:Name="ReadAutoNumber" Content="{l:Loc Read.AutoNumber}" Margin="8" Checked="ReadInput_Changed" Unchecked="ReadInput_Changed" />
                                        <ComboBox x:Name="ReadSequenceKind" Width="120" SelectedIndex="0" SelectionChanged="ReadInput_Changed">
                                            <ComboBoxItem Content="{l:Loc Read.Digits}" />
                                            <ComboBoxItem Content="{l:Loc Read.Letters}" />
                                        </ComboBox>
                                        <ComboBox x:Name="ReadSequenceWidth" Width="90" SelectedIndex="0" SelectionChanged="ReadInput_Changed">
                                            <ComboBoxItem Content="0 / A" />
                                            <ComboBoxItem Content="00 / AA" />
                                            <ComboBoxItem Content="000 / AAA" />
                                        </ComboBox>
                                        <TextBlock Text="{l:Loc Read.Next}" VerticalAlignment="Center" Margin="14,0,5,0" />
                                        <TextBox x:Name="ReadSequenceValue" Width="80" Text="1" TextChanged="ReadInput_Changed" />
                                        <TextBlock x:Name="ReadNamePreview" VerticalAlignment="Center" Margin="14,0" FontWeight="SemiBold" />
                                    </WrapPanel>
                                    <TextBlock Text="{l:Loc Common.ExpertArguments}" Margin="8,12,8,4" />
                                    <TextBox x:Name="ReadExpertArguments" Margin="8" TextChanged="ReadInput_Changed" ToolTip="{l:Loc Common.ExpertArgumentsTip}" />
                                </StackPanel>
                            </Border>
                        </Expander>
                        <Border Grid.Row="5" x:Name="OpenScpBanner" Visibility="Collapsed" Background="#E7F0FF" BorderBrush="#4D76E8" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:Loc Read.OpenVisualize}" Click="OpenLastScp_Click" />
                                <TextBlock Text="{l:Loc Read.ScpFinished}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>
                        <Button Grid.Row="6" x:Name="ReadExecuteButton" Content="{l:Loc Common.Execute}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="ExecuteRead_Click" />
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{l:Loc Tab.Write}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{l:Loc Common.Save}" Click="SaveWriteProfile_Click" />
                                <Button Content="{l:Loc Common.Reset}" Click="ResetWriteProfile_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{l:Loc Common.Profile}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ComboBox x:Name="WriteProfileCombo" Width="260" DisplayMemberPath="Name" SelectionChanged="WriteProfile_Changed" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Loc Write.Source}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox x:Name="WriteSourceText" Grid.Column="1" IsReadOnly="True" />
                            <Button Grid.Column="2" Content="{l:Loc Common.Choose}" Click="BrowseWriteSource_Click" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:Loc Common.Modify}" Click="ToggleWriteFormat_Click" />
                                <StackPanel>
                                    <TextBlock Text="{l:Loc Write.Detected}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="WriteDetectionText" Text="{l:Loc Write.ChooseImage}" Margin="0,5,12,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                            <ComboBox Grid.Row="1" x:Name="WriteFormatCombo" Margin="0,12,0,0" Visibility="Collapsed" DisplayMemberPath="DisplayName" SelectionChanged="WriteInput_Changed" />
                        </Grid>
                    </Border>
                    <Expander Grid.Row="3" Header="{l:Loc Common.Advanced}">
                        <Border Style="{StaticResource Card}" Margin="0,10,0,12">
                            <StackPanel>
                                <WrapPanel>
                                    <CheckBox x:Name="WriteNoVerify" Content="{l:Loc Write.NoVerify}" Foreground="#B3261E" Margin="8" Checked="WriteInput_Changed" Unchecked="WriteInput_Changed" ToolTip="{l:Loc Write.NoVerifyTip}" />
                                    <CheckBox x:Name="WriteEraseEmpty" Content="{l:Loc Write.EraseEmpty}" Margin="16,8" Checked="WriteInput_Changed" Unchecked="WriteInput_Changed" />
                                    <CheckBox x:Name="WriteRetriesEnabled" Content="{l:Loc Read.Retries}" Margin="16,8,8,8" Checked="WriteInput_Changed" Unchecked="WriteInput_Changed" />
                                    <TextBox x:Name="WriteRetriesValue" Width="70" Text="3" TextChanged="WriteInput_Changed" />
                                </WrapPanel>
                                <WrapPanel>
                                    <CheckBox x:Name="WriteTracksEnabled" Content="{l:Loc Read.Tracks}" Margin="8" Checked="WriteInput_Changed" Unchecked="WriteInput_Changed" />
                                    <TextBox x:Name="WriteTracksValue" Width="190" Text="c=0-79:h=0-1" TextChanged="WriteInput_Changed" />
                                    <CheckBox x:Name="WritePreErase" Content="{l:Loc Advanced.PreErase}" Margin="18,8" Checked="WriteInput_Changed" Unchecked="WriteInput_Changed" />
                                    <CheckBox x:Name="WriteReverse" Content="{l:Loc Advanced.Reverse}" Margin="8" Checked="WriteInput_Changed" Unchecked="WriteInput_Changed" />
                                </WrapPanel>
                                <WrapPanel>
                                    <CheckBox x:Name="WriteFakeIndexEnabled" Content="{l:Loc Advanced.FakeIndex}" Margin="8" Checked="WriteFakeIndex_Checked" Unchecked="WriteInput_Changed" />
                                    <TextBox x:Name="WriteFakeIndexValue" Width="90" Text="300rpm" TextChanged="WriteInput_Changed" />
                                    <CheckBox x:Name="WriteHardSectors" Content="{l:Loc Advanced.HardSectors}" Margin="18,8" Checked="WriteHardSectors_Checked" Unchecked="WriteInput_Changed" />
                                    <CheckBox x:Name="WritePrecompEnabled" Content="{l:Loc Advanced.Precomp}" Margin="18,8,8,8" Checked="WriteInput_Changed" Unchecked="WriteInput_Changed" />
                                    <TextBox x:Name="WritePrecompValue" Width="170" Text="type=mfm:40=125" TextChanged="WriteInput_Changed" />
                                </WrapPanel>
                                <WrapPanel>
                                    <CheckBox x:Name="WriteDenselEnabled" Content="{l:Loc Advanced.DensityPin}" Margin="8" Checked="WriteDensel_Checked" Unchecked="WriteInput_Changed" />
                                    <ComboBox x:Name="WriteDenselValue" Width="70" SelectedIndex="0" SelectionChanged="WriteInput_Changed"><ComboBoxItem Content="H"/><ComboBoxItem Content="L"/></ComboBox>
                                    <CheckBox x:Name="WriteTg43" Content="{l:Loc Advanced.Tg43}" Margin="18,8" Checked="WriteTg43_Checked" Unchecked="WriteInput_Changed" />
                                </WrapPanel>
                                <TextBlock Text="{l:Loc Common.ExpertArguments}" Margin="8,12,8,4" />
                                <TextBox x:Name="WriteExpertArguments" Margin="8" TextChanged="WriteInput_Changed" />
                            </StackPanel>
                        </Border>
                    </Expander>
                    <Button Grid.Row="4" x:Name="WriteExecuteButton" Content="{l:Loc Common.Execute}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="ExecuteWrite_Click" />
                </Grid>
            </TabItem>
            <TabItem Header="{l:Loc Tab.Convert}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="{l:Loc Common.Save}" Click="SaveConvertProfile_Click"/><Button Content="{l:Loc Common.Reset}" Click="ResetConvertProfile_Click"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{l:Loc Common.Profile}" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="ConvertProfileCombo" Width="260" DisplayMemberPath="Name" SelectionChanged="ConvertProfile_Changed"/></StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:Loc Conversion.Source}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox x:Name="ConvertSourceText" Grid.Column="1" IsReadOnly="True" />
                            <Button Grid.Column="2" Content="{l:Loc Common.Choose}" Click="BrowseConvertSource_Click" />
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="{l:Loc Conversion.OutputNames}" VerticalAlignment="Center" />
                                <TextBox x:Name="ConvertOutputName" Width="330" Margin="12,0" TextChanged="ConvertInput_Changed" />
                                <CheckBox x:Name="ConvertTags" Content="{l:Loc Conversion.AddTags}" VerticalAlignment="Center" Checked="ConvertInput_Changed" Unchecked="ConvertInput_Changed" />
                                <TextBlock x:Name="ConvertSourceInfo" Margin="18,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{l:Loc Conversion.Selected}" FontSize="18" FontWeight="SemiBold" Margin="4,4,4,10" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel x:Name="ConvertPinnedPanel" />
                            </Border>
                            <TextBlock Text="{l:Loc Conversion.CommonFormats}" FontSize="17" FontWeight="SemiBold" Margin="4" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel x:Name="ConvertCommonPanel" />
                            </Border>
                            <Expander Header="{l:Loc Conversion.ShowRare}">
                                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                    <StackPanel x:Name="ConvertRarePanel" />
                                </Border>
                            </Expander>
                            <Expander Header="{l:Loc Common.Advanced}">
                                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <CheckBox x:Name="ConvertTracksEnabled" Content="{l:Loc Conversion.LimitTracks}" Checked="ConvertInput_Changed" Unchecked="ConvertInput_Changed" />
                                        <TextBox x:Name="ConvertTracksValue" Text="c=0-79:h=0-1" Margin="0,6,0,12" TextChanged="ConvertInput_Changed" />
                                        <WrapPanel>
                                            <CheckBox x:Name="ConvertOutTracksEnabled" Content="{l:Loc Advanced.OutputTracks}" Margin="0,0,8,0" Checked="ConvertInput_Changed" Unchecked="ConvertInput_Changed" />
                                            <TextBox x:Name="ConvertOutTracksValue" Width="190" Text="c=0-79:h=0-1" TextChanged="ConvertInput_Changed" />
                                            <CheckBox x:Name="ConvertAdjustSpeedEnabled" Content="{l:Loc Advanced.AdjustSpeed}" Margin="18,0,8,0" Checked="ConvertInput_Changed" Unchecked="ConvertInput_Changed" />
                                            <TextBox x:Name="ConvertAdjustSpeedValue" Width="90" Text="300rpm" TextChanged="ConvertInput_Changed" />
                                        </WrapPanel>
                                        <WrapPanel Margin="0,10,0,12">
                                            <CheckBox x:Name="ConvertPllEnabled" Content="{l:Loc Advanced.Pll}" Margin="0,0,8,0" Checked="ConvertInput_Changed" Unchecked="ConvertInput_Changed" />
                                            <TextBox x:Name="ConvertPllValue" Width="180" Text="period=5:phase=60" TextChanged="ConvertInput_Changed" />
                                            <CheckBox x:Name="ConvertHardSectors" Content="{l:Loc Advanced.HardSectors}" Margin="18,0" Checked="ConvertInput_Changed" Unchecked="ConvertInput_Changed" />
                                            <CheckBox x:Name="ConvertReverse" Content="{l:Loc Advanced.Reverse}" Margin="8,0" Checked="ConvertInput_Changed" Unchecked="ConvertInput_Changed" />
                                        </WrapPanel>
                                        <TextBlock Text="{l:Loc Common.ExpertArguments}" />
                                        <TextBox x:Name="ConvertExpertArguments" Margin="0,6,0,0" TextChanged="ConvertInput_Changed" />
                                    </StackPanel>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="3" x:Name="ConvertExecuteButton" Content="{l:Loc Common.Execute}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="ExecuteConvert_Click" />
                </Grid>
            </TabItem>
            <TabItem Header="{l:Loc Tab.Visualize}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="{l:Loc Visual.Decoder}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <ComboBox x:Name="ScpDecoderCombo" Width="230" DisplayMemberPath="Name" SelectionChanged="ScpDecoder_Changed" />
                                <CheckBox x:Name="LinkScpViews" Content="{l:Loc Visual.LinkZoom}" IsChecked="True" VerticalAlignment="Center" Margin="14,0" />
                                <Button Content="{l:Loc Common.Reset}" Click="ResetScpViews_Click" />
                                <Button Content="{l:Loc Visual.OpenScp}" Click="OpenScp_Click" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="ScpFileName" Text="{l:Loc Visual.NoFile}" FontWeight="SemiBold" />
                                <TextBlock x:Name="ScpSummary" Text="{l:Loc Visual.Waiting}" Margin="0,5,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition x:Name="ScpInspectorColumn" Width="290" />
                        </Grid.ColumnDefinitions>
                        <local:ScpDiskView x:Name="ScpSide0" Margin="4" />
                        <local:ScpDiskView x:Name="ScpSide1" Grid.Column="1" Margin="4" />
                        <Border x:Name="ScpInspector" Grid.Column="2" Style="{StaticResource Card}" Margin="8,4,0,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{l:Loc Common.Hide}" Padding="8,2" MinHeight="24" Click="ToggleScpInspector_Click" />
                                    <TextBlock Text="{l:Loc Visual.Inspector}" FontSize="18" FontWeight="SemiBold" />
                                </DockPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="ScpTrackInfo" Text="{l:Loc Visual.SelectTrack}" Margin="0,16,0,0" TextWrapping="Wrap" />
                                </ScrollViewer>
                                <TextBlock Grid.Row="2" Text="{l:Loc Visual.Controls}" Foreground="#69707D" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </Grid>
                    <DockPanel Grid.Row="2" Margin="8">
                        <Button DockPanel.Dock="Right" Content="{l:Loc Visual.Inspector}" Padding="8,2" MinHeight="24" Click="ToggleScpInspector_Click" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:Loc Visual.NormalFlux}" Foreground="#24B35D" />
                            <TextBlock Text="{l:Loc Visual.ShortTransition}" Foreground="#8F68FF" Margin="18,0" />
                            <TextBlock Text="{l:Loc Visual.LongTransition}" Foreground="#53ADFF" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>
            <TabItem Header="{l:Loc Tab.Tools}">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="ToolsList" SelectedIndex="0" SelectionChanged="ToolsList_SelectionChanged">
                        <ListBoxItem Content="{l:Loc Tools.Erase}" />
                        <ListBoxItem Content="{l:Loc Tools.Clean}" />
                    </ListBox>
                    <Grid Grid.Column="1" Margin="16,0,0,0">
                        <Border x:Name="ErasePanel" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Tools.Erase}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="{l:Loc Tools.EraseWarning}" Foreground="#B3261E" Margin="0,8,0,18" />
                                <WrapPanel>
                                    <CheckBox x:Name="EraseTracksEnabled" Content="{l:Loc Tools.LimitTracks}" Margin="8" Checked="ToolInput_Changed" Unchecked="ToolInput_Changed" />
                                    <TextBox x:Name="EraseTracksValue" Width="180" Text="c=0-79:h=0-1" TextChanged="ToolInput_Changed" />
                                    <CheckBox x:Name="EraseRevsEnabled" Content="{l:Loc Tools.Revolutions}" Margin="18,8,8,8" Checked="ToolInput_Changed" Unchecked="ToolInput_Changed" />
                                    <TextBox x:Name="EraseRevsValue" Width="70" Text="3" TextChanged="ToolInput_Changed" />
                                </WrapPanel>
                                <TextBlock Text="{l:Loc Common.ExpertArguments}" Margin="8,14,8,4" />
                                <TextBox x:Name="EraseExpertArguments" Margin="8" TextChanged="ToolInput_Changed" />
                                <Button x:Name="EraseExecuteButton" Content="{l:Loc Common.Execute}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="ExecuteErase_Click" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="CleanPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Tools.Clean}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="{l:Loc Tools.CleanWarning}" Foreground="#8A4B00" Margin="0,8,0,18" />
                                <WrapPanel>
                                    <CheckBox x:Name="CleanCylindersEnabled" Content="{l:Loc Tools.Cylinders}" Margin="8" Checked="ToolInput_Changed" Unchecked="ToolInput_Changed" />
                                    <TextBox x:Name="CleanCylindersValue" Width="70" Text="80" TextChanged="ToolInput_Changed" />
                                    <CheckBox x:Name="CleanPassesEnabled" Content="{l:Loc Tools.Passes}" Margin="18,8,8,8" Checked="ToolInput_Changed" Unchecked="ToolInput_Changed" />
                                    <TextBox x:Name="CleanPassesValue" Width="70" Text="3" TextChanged="ToolInput_Changed" />
                                    <CheckBox x:Name="CleanLingerEnabled" Content="{l:Loc Tools.Linger}" Margin="18,8,8,8" Checked="ToolInput_Changed" Unchecked="ToolInput_Changed" />
                                    <TextBox x:Name="CleanLingerValue" Width="80" Text="100" TextChanged="ToolInput_Changed" />
                                </WrapPanel>
                                <TextBlock Text="{l:Loc Common.ExpertArguments}" Margin="8,14,8,4" />
                                <TextBox x:Name="CleanExpertArguments" Margin="8" TextChanged="ToolInput_Changed" />
                                <Button x:Name="CleanExecuteButton" Content="{l:Loc Common.Execute}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="ExecuteClean_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <GridSplitter x:Name="ConsoleSplitter" Grid.Row="2" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows" />
        <Border Grid.Row="3" x:Name="ConsolePanel" Background="#11151B" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{l:Loc Common.Hide}" Padding="8,2" MinHeight="24" Click="ToggleConsole_Click" />
                    <TextBlock Text="{l:Loc Common.Command}" Foreground="White" FontWeight="SemiBold" />
                </DockPanel>
                <TextBox Grid.Row="1" x:Name="CommandPreview" Background="Transparent" Foreground="#B7F7C3" BorderThickness="0" IsReadOnly="True" FontFamily="Consolas" />
                <TextBox Grid.Row="2" x:Name="LogOutput" Background="Transparent" Foreground="#D9DEE7" BorderThickness="0" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Text="{l:Loc Status.Ready}" />
            </Grid>
        </Border>
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <Ellipse x:Name="HardwareStatusLight" Width="10" Height="10" Fill="#888" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="HardwareStatusText" Text="{l:Loc Hardware.NotConfigured}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem x:Name="HardwareSelectorItem" Visibility="Collapsed">
                <ComboBox x:Name="HardwareSelector" MinWidth="260" DisplayMemberPath="Label" SelectionChanged="HardwareSelector_Changed" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem x:Name="ProfileStatusItem"><TextBlock x:Name="ProfileStatusText" Text="{l:Loc Status.DefaultProfile}" /></StatusBarItem>
            <StatusBarItem x:Name="ProgressStatusItem" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal"><ProgressBar x:Name="OperationProgress" Width="180" Height="12" Minimum="0" Maximum="100"/><TextBlock x:Name="OperationProgressText" Margin="8,0,0,0"/></StackPanel>
            </StatusBarItem>
            <StatusBarItem x:Name="HostToolsUpdateItem" Visibility="Collapsed"><Button x:Name="HostToolsUpdateButton" Padding="8,1" MinHeight="22" Click="Preferences_Click" /></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button Content="{l:Loc Common.Console}" Padding="8,1" MinHeight="22" Click="ToggleConsole_Click" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
