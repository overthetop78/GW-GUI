<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GWGUI.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GWGUI.App" xmlns:controls="clr-namespace:GWGUI.App.Controls" xmlns:l="clr-namespace:GWGUI.App.Localization" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" Title="{l:Loc App.Title}" MinWidth="1280" MinHeight="720" Width="1360" Height="820" WindowStartupLocation="CenterScreen" Closing="Window_Closing" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="ConsoleRow" Height="190" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <controls:MainMenu x:Name="ApplicationMenu"/>
        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="16,10,16,0" SelectionChanged="MainTabs_SelectionChanged" AutomationProperties.Name="{l:Loc App.Title}">
            <TabItem Style="{StaticResource MainTabItemStyle}" automation:AutomationProperties.Name="{l:Loc Tab.Read}"><TabItem.Header><controls:MainTabHeader Icon="&#xE768;" Text="{l:Loc Tab.Read}"/></TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
                            <controls:ReadImageSection x:Name="ReadImageBlock" Margin="0,0,6,12"/>
                            <controls:ProfileSection x:Name="ReadProfileBlock" Grid.Column="1" Margin="6,0,0,12"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                            <controls:PathSection x:Name="ReadFolderBlock" Label="{l:Loc Read.Folder}" Text="{Binding Read.Folder, Mode=TwoWay}" Margin="0,0,6,12"/>
                            <controls:ReadFileNameSection x:Name="ReadFileNameBlock" Grid.Column="1" Margin="6,0,0,12"/>
                        </Grid>
                        <Expander Grid.Row="0" Header="{l:Loc Common.Advanced}">
                            <Border Style="{StaticResource Card}" Margin="0,10,0,12">
                                <StackPanel>
                                    <WrapPanel>
                                        <CheckBox x:Name="ReadRevsEnabled" IsChecked="{Binding Read.Revs.Enabled, Mode=TwoWay}" Content="{l:Loc Read.Revolutions}" Margin="8" Checked="ReadInput_Changed" Unchecked="ReadInput_Changed" ToolTip="{l:Loc Advanced.RevsTip}" />
                                        <TextBox x:Name="ReadRevsValue" Width="70" Text="{Binding Read.Revs.Value, UpdateSourceTrigger=PropertyChanged}" TextChanged="ReadInput_Changed" />
                                        <CheckBox x:Name="ReadRetriesEnabled" IsChecked="{Binding Read.Retries.Enabled}" Content="{l:Loc Read.Retries}" Margin="18,8,8,8" Checked="ReadInput_Changed" Unchecked="ReadInput_Changed" ToolTip="{l:Loc Advanced.RetriesTip}" />
                                        <TextBox x:Name="ReadRetriesValue" Width="70" Text="{Binding Read.Retries.Value, UpdateSourceTrigger=PropertyChanged}" TextChanged="ReadInput_Changed" />
                                        <CheckBox x:Name="ReadTracksEnabled" IsChecked="{Binding Read.Tracks.Enabled}" Content="{l:Loc Read.Tracks}" Margin="18,8,8,8" Checked="ReadInput_Changed" Unchecked="ReadInput_Changed" ToolTip="{l:Loc Advanced.TracksTip}" />
                                        <TextBox x:Name="ReadTracksValue" Width="190" Text="{Binding Read.Tracks.Value, UpdateSourceTrigger=PropertyChanged}" TextChanged="ReadInput_Changed" ToolTip="{l:Loc Advanced.TrackSpecTip}" />
                                    </WrapPanel>
                                    <WrapPanel>
                                        <CheckBox x:Name="ReadSeekRetriesEnabled" IsChecked="{Binding Read.SeekRetries.Enabled}" Content="{l:Loc Advanced.SeekRetries}" Margin="8" Checked="ReadInput_Changed" Unchecked="ReadInput_Changed" ToolTip="{l:Loc Advanced.SeekRetriesTip}" />
                                        <TextBox x:Name="ReadSeekRetriesValue" Width="70" Text="{Binding Read.SeekRetries.Value, UpdateSourceTrigger=PropertyChanged}" TextChanged="ReadInput_Changed" />
                                        <CheckBox x:Name="ReadFakeIndexEnabled" IsChecked="{Binding Read.FakeIndex.Enabled}" Content="{l:Loc Advanced.FakeIndex}" Margin="18,8,8,8" Checked="ReadFakeIndex_Checked" Unchecked="ReadInput_Changed" ToolTip="{l:Loc Advanced.FakeIndexTip}" />
                                        <TextBox x:Name="ReadFakeIndexValue" Width="90" Text="{Binding Read.FakeIndex.Value, UpdateSourceTrigger=PropertyChanged}" TextChanged="ReadInput_Changed" ToolTip="{l:Loc Advanced.SpeedTip}" />
                                        <CheckBox x:Name="ReadHardSectors" IsChecked="{Binding Read.HardSectors.Enabled}" Content="{l:Loc Advanced.HardSectors}" Margin="18,8" Checked="ReadHardSectors_Checked" Unchecked="ReadInput_Changed" ToolTip="{l:Loc Advanced.HardSectorsTip}" />
                                        <CheckBox x:Name="ReadReverse" IsChecked="{Binding Read.Reverse.Enabled}" Content="{l:Loc Advanced.Reverse}" Margin="8" Checked="ReadInput_Changed" Unchecked="ReadInput_Changed" ToolTip="{l:Loc Advanced.ReverseTip}" />
                                    </WrapPanel>
                                    <WrapPanel>
                                        <CheckBox x:Name="ReadAdjustSpeedEnabled" IsChecked="{Binding Read.AdjustSpeed.Enabled}" Content="{l:Loc Advanced.AdjustSpeed}" Margin="8" Checked="ReadInput_Changed" Unchecked="ReadInput_Changed" ToolTip="{l:Loc Advanced.AdjustSpeedTip}" />
                                        <TextBox x:Name="ReadAdjustSpeedValue" Width="90" Text="{Binding Read.AdjustSpeed.Value, UpdateSourceTrigger=PropertyChanged}" TextChanged="ReadInput_Changed" ToolTip="{l:Loc Advanced.SpeedTip}" />
                                        <CheckBox x:Name="ReadPllEnabled" IsChecked="{Binding Read.Pll.Enabled}" Content="{l:Loc Advanced.Pll}" Margin="18,8,8,8" Checked="ReadInput_Changed" Unchecked="ReadInput_Changed" ToolTip="{l:Loc Advanced.PllOptionTip}" />
                                        <TextBox x:Name="ReadPllValue" Width="180" Text="{Binding Read.Pll.Value, UpdateSourceTrigger=PropertyChanged}" TextChanged="ReadInput_Changed" ToolTip="{l:Loc Advanced.PllTip}" />
                                        <CheckBox x:Name="ReadDenselEnabled" IsChecked="{Binding Read.Densel.Enabled}" Content="{l:Loc Advanced.DensityPin}" Margin="18,8,8,8" Checked="ReadDensel_Checked" Unchecked="ReadInput_Changed" ToolTip="{l:Loc Advanced.DenselTip}" />
                                        <ComboBox x:Name="ReadDenselValue" Width="70" SelectedValuePath="Content" SelectedValue="{Binding Read.Densel.Value}" SelectionChanged="ReadInput_Changed"><ComboBoxItem Content="H"/><ComboBoxItem Content="L"/></ComboBox>
                                        <CheckBox x:Name="ReadTg43" IsChecked="{Binding Read.Tg43.Enabled}" Content="{l:Loc Advanced.Tg43}" Margin="18,8" Checked="ReadTg43_Checked" Unchecked="ReadInput_Changed" ToolTip="{l:Loc Advanced.Tg43Tip}" />
                                    </WrapPanel>
                                    <Separator Margin="8" />
                                    <DockPanel Margin="8,4" ToolTip="{l:Loc Advanced.DiskDefsTip}"><Button DockPanel.Dock="Right" Content="{l:Loc Common.Browse}" Click="BrowseReadDiskDefs_Click"/><CheckBox x:Name="ReadDiskDefsEnabled" IsChecked="{Binding Read.DiskDefs.Enabled}" Content="{l:Loc Advanced.DiskDefs}" VerticalAlignment="Center" Checked="ReadInput_Changed" Unchecked="ReadInput_Changed"/><TextBox x:Name="ReadDiskDefsValue" Margin="10,0" IsReadOnly="True" Text="{Binding Read.DiskDefs.Value, Mode=TwoWay}" TextChanged="ReadInput_Changed"/></DockPanel>
                                    <WrapPanel>
                                        <CheckBox x:Name="ReadAutoNumber" Content="{l:Loc Read.AutoNumber}" Margin="8" IsChecked="{Binding Read.AutoNumber}" Checked="ReadInput_Changed" Unchecked="ReadInput_Changed" />
                                        <ComboBox x:Name="ReadSequenceKind" Width="120" SelectedIndex="{Binding Read.SequenceKindIndex}" SelectionChanged="ReadSequenceKind_Changed">
                                            <ComboBoxItem Content="{l:Loc Read.Digits}" />
                                            <ComboBoxItem Content="{l:Loc Read.Letters}" />
                                        </ComboBox>
                                        <ComboBox x:Name="ReadSequenceWidth" Width="90" SelectedIndex="{Binding Read.SequenceWidthIndex}" SelectionChanged="ReadInput_Changed">
                                            <ComboBoxItem Content="0 / A" />
                                            <ComboBoxItem Content="00 / AA" />
                                            <ComboBoxItem Content="000 / AAA" />
                                        </ComboBox>
                                        <TextBlock Text="{l:Loc Read.Next}" VerticalAlignment="Center" Margin="14,0,5,0" />
                                        <TextBox x:Name="ReadSequenceValue" Width="80" Text="{Binding Read.SequenceValue, UpdateSourceTrigger=PropertyChanged}" TextChanged="ReadInput_Changed" />
                                        <TextBlock x:Name="ReadNamePreview" VerticalAlignment="Center" Margin="14,0" FontWeight="SemiBold" />
                                    </WrapPanel>
                                    <TextBlock Text="{l:Loc Common.ExpertArguments}" Margin="8,12,8,4" />
                                    <TextBox x:Name="ReadExpertArguments" Margin="8" Text="{Binding Read.ExpertArguments, UpdateSourceTrigger=PropertyChanged}" TextChanged="ReadInput_Changed" ToolTip="{l:Loc Common.ExpertArgumentsTip}" />
                                </StackPanel>
                            </Border>
                        </Expander>
                        <Border Grid.Row="5" x:Name="OpenScpBanner" Visibility="Collapsed" Background="#E7F0FF" BorderBrush="#4D76E8" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{l:Loc Read.OpenVisualize}" Click="OpenLastScp_Click" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{l:Loc Read.ScpFinished}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="OpenScpSummaryText" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
                    <Button Grid.Row="1" x:Name="ReadExecuteButton" Content="{l:Loc Common.Execute}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="16,4,16,12" Click="ExecuteRead_Click" />
                </Grid>
            </TabItem>
            <TabItem Style="{StaticResource MainTabItemStyle}" automation:AutomationProperties.Name="{l:Loc Tab.Write}"><TabItem.Header><controls:MainTabHeader Icon="&#xE70F;" Text="{l:Loc Tab.Write}"/></TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                    <controls:WriteAdvancedSection x:Name="WriteAdvancedBlock" Grid.Row="0"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
                                <controls:PathSection x:Name="WriteSourceBlock" Label="{l:Loc Write.Source}" Text="{Binding Write.SourcePath, Mode=TwoWay}" Margin="0,0,6,12"/>
                                <controls:ProfileSection x:Name="WriteProfileBlock" Grid.Column="1" Margin="6,0,0,12"/>
                            </Grid>
                            <controls:WriteFormatSection x:Name="WriteFormatBlock" Grid.Row="2" Margin="0,0,0,12"/>
                        </Grid>
                    </ScrollViewer>
                    <Button Grid.Row="1" x:Name="WriteExecuteButton" Content="{l:Loc Common.Execute}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="16,4,16,12" Click="ExecuteWrite_Click" />
                </Grid>
            </TabItem>
            <TabItem Style="{StaticResource MainTabItemStyle}" automation:AutomationProperties.Name="{l:Loc Tab.Convert}"><TabItem.Header><controls:MainTabHeader Icon="&#xE895;" Text="{l:Loc Tab.Convert}"/></TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <Grid Margin="16">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <controls:ConversionAdvancedSection x:Name="ConvertAdvancedBlock" Grid.Row="0"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
                                <controls:PathSection x:Name="ConvertSourceBlock" Label="{l:Loc Conversion.Source}" Text="{Binding Conversion.SourcePath, Mode=TwoWay}" ActionText="{l:Loc Write.VisualizeTracks}" Margin="0,0,6,12"/>
                                <controls:ProfileSection x:Name="ConvertProfileBlock" Grid.Column="1" Margin="6,0,0,12"/>
                            </Grid>
                            <controls:ConversionOutputSection x:Name="ConvertOutputBlock" Grid.Row="2" Margin="0,0,0,12"/>
                            <controls:ConversionFormatsSection x:Name="ConvertFormatsBlock" Grid.Row="3"/>
                        </Grid>
                    </ScrollViewer>
                    <Button Grid.Row="1" x:Name="ConvertExecuteButton" Content="{l:Loc Common.Execute}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="16,4,16,12" Click="ExecuteConvert_Click" />
                </Grid>
            </TabItem>
            <TabItem Style="{StaticResource MainTabItemStyle}" automation:AutomationProperties.Name="{l:Loc Tab.Visualize}"><TabItem.Header><controls:MainTabHeader Icon="&#xE9D2;" Text="{l:Loc Tab.Visualize}"/></TabItem.Header>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <controls:VisualizerHeaderSection x:Name="VisualizerHeader"/>
                    <Grid x:Name="ScpVisualizationArea" Grid.Row="1" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <local:ScpDiskView x:Name="ScpSide0" Margin="4" />
                        <local:ScpDiskView x:Name="ScpSide1" Grid.Column="1" Margin="4" />
                        <Canvas x:Name="ScpInspectorLayer" Grid.ColumnSpan="2" Panel.ZIndex="10">
                            <controls:ScpInspectorPanel x:Name="ScpInspector" Width="390" Height="410" Visibility="Collapsed"/>
                        </Canvas>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="8,4">
                        <DockPanel><Button DockPanel.Dock="Right" Content="{l:Loc Visual.Inspector}" Padding="8,2" MinHeight="24" Click="ToggleScpInspector_Click"/><controls:VisualizerLegend/></DockPanel>
                        <controls:VisualizerTrackOverview x:Name="VisualizerTrackOverview" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Style="{StaticResource MainTabItemStyle}" automation:AutomationProperties.Name="{l:Loc Tab.Tools}"><TabItem.Header><controls:MainTabHeader Icon="&#xE90F;" Text="{l:Loc Tab.Tools}"/></TabItem.Header>
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="ToolsList" SelectedIndex="0" SelectionChanged="ToolsList_SelectionChanged">
                        <ListBoxItem Content="{l:Loc Tools.Erase}" />
                        <ListBoxItem Content="{l:Loc Tools.Clean}" />
                    </ListBox>
                    <Grid Grid.Column="1" Margin="16,0,0,0">
                        <Border x:Name="ErasePanel" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Tools.Erase}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="{l:Loc Tools.EraseWarning}" Foreground="#B3261E" Margin="0,8,0,18" />
                                <WrapPanel>
                                    <CheckBox x:Name="EraseTracksEnabled" Content="{l:Loc Tools.LimitTracks}" Margin="8" Checked="ToolInput_Changed" Unchecked="ToolInput_Changed" />
                                    <TextBox x:Name="EraseTracksValue" Width="180" Text="c=0-79:h=0-1" TextChanged="ToolInput_Changed" AutomationProperties.Name="{l:Loc Tools.LimitTracks}" />
                                    <CheckBox x:Name="EraseRevsEnabled" Content="{l:Loc Tools.Revolutions}" Margin="18,8,8,8" Checked="ToolInput_Changed" Unchecked="ToolInput_Changed" />
                                    <TextBox x:Name="EraseRevsValue" Width="70" Text="3" TextChanged="ToolInput_Changed" AutomationProperties.Name="{l:Loc Tools.Revolutions}" />
                                </WrapPanel>
                                <TextBlock Text="{l:Loc Common.ExpertArguments}" Margin="8,14,8,4" />
                                <TextBox x:Name="EraseExpertArguments" Margin="8" TextChanged="ToolInput_Changed" AutomationProperties.Name="{l:Loc Common.ExpertArguments}" />
                                <Button x:Name="EraseExecuteButton" Content="{l:Loc Common.Execute}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="ExecuteErase_Click" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="CleanPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="{l:Loc Tools.Clean}" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="{l:Loc Tools.CleanWarning}" Foreground="#8A4B00" Margin="0,8,0,18" />
                                <WrapPanel>
                                    <CheckBox x:Name="CleanCylindersEnabled" Content="{l:Loc Tools.Cylinders}" Margin="8" Checked="ToolInput_Changed" Unchecked="ToolInput_Changed" />
                                    <TextBox x:Name="CleanCylindersValue" Width="70" Text="80" TextChanged="ToolInput_Changed" AutomationProperties.Name="{l:Loc Tools.Cylinders}" />
                                    <CheckBox x:Name="CleanPassesEnabled" Content="{l:Loc Tools.Passes}" Margin="18,8,8,8" Checked="ToolInput_Changed" Unchecked="ToolInput_Changed" />
                                    <TextBox x:Name="CleanPassesValue" Width="70" Text="3" TextChanged="ToolInput_Changed" AutomationProperties.Name="{l:Loc Tools.Passes}" />
                                    <CheckBox x:Name="CleanLingerEnabled" Content="{l:Loc Tools.Linger}" Margin="18,8,8,8" Checked="ToolInput_Changed" Unchecked="ToolInput_Changed" />
                                    <TextBox x:Name="CleanLingerValue" Width="80" Text="100" TextChanged="ToolInput_Changed" AutomationProperties.Name="{l:Loc Tools.Linger}" />
                                </WrapPanel>
                                <TextBlock Text="{l:Loc Common.ExpertArguments}" Margin="8,14,8,4" />
                                <TextBox x:Name="CleanExpertArguments" Margin="8" TextChanged="ToolInput_Changed" AutomationProperties.Name="{l:Loc Common.ExpertArguments}" />
                                <Button x:Name="CleanExecuteButton" Content="{l:Loc Common.Execute}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="ExecuteClean_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <GridSplitter x:Name="ConsoleSplitter" Grid.Row="2" Height="4" HorizontalAlignment="Stretch" ResizeDirection="Rows" Background="Transparent" BorderThickness="0" />
        <controls:TerminalSection Grid.Row="3" x:Name="TerminalBlock" Margin="16,8"/>
        <Border x:Name="AppStatusBar" Grid.Row="4" Height="30" Background="{DynamicResource StatusBrush}" ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="245"/><ColumnDefinition Width="165"/><ColumnDefinition Width="125"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StatusBarItem Grid.Column="0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="HardwareStatusLight" Width="10" Height="10" Fill="{Binding HardwareBrush}" Margin="0,0,8,0"/><TextBlock x:Name="HardwareStatusText" Text="{Binding HardwareText}" TextTrimming="CharacterEllipsis"/><ComboBox x:Name="HardwareSelector" Width="245" DisplayMemberPath="Label" SelectionChanged="HardwareSelector_Changed" AutomationProperties.Name="{l:Loc Menu.Hardware}" Visibility="Collapsed"/></StackPanel></StatusBarItem>
                <StatusBarItem Grid.Column="1" x:Name="ProfileStatusItem" Visibility="{Binding ProfileVisibility}"><TextBlock x:Name="ProfileStatusText" Text="{Binding ProfileText}" TextTrimming="CharacterEllipsis"/></StatusBarItem>
                <StatusBarItem Grid.Column="2" x:Name="OperationStatusItem"><StackPanel Orientation="Horizontal"><Ellipse x:Name="OperationStatusLight" Width="10" Height="10" Fill="{Binding OperationBrush}" Margin="0,0,8,0"/><TextBlock x:Name="OperationStatusText" Text="{Binding OperationText}" TextTrimming="CharacterEllipsis"/></StackPanel></StatusBarItem>
                <StatusBarItem Grid.Column="3" x:Name="ProgressStatusItem" Visibility="{Binding ProgressVisibility}" HorizontalContentAlignment="Stretch">
                    <Grid>
                        <Grid x:Name="GlobalProgressPanel" Visibility="{Binding GlobalProgressVisibility}"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><ProgressBar x:Name="OperationProgress" Height="10" Minimum="0" Maximum="100" IsIndeterminate="{Binding ProgressIndeterminate}" Value="{Binding ProgressValue}"/><TextBlock Grid.Column="1" x:Name="OperationProgressText" Margin="10,0,0,0" Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis"/></Grid>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <controls:TrackProgressStrip x:Name="Face0TrackProgress" Visibility="{Binding Face0ProgressVisibility}"/>
                            <controls:TrackProgressStrip x:Name="Face1TrackProgress" Grid.Row="1" Visibility="{Binding Face1ProgressVisibility}"/>
                        </Grid>
                    </Grid>
                </StatusBarItem>
                <StatusBarItem Grid.Column="4" x:Name="HostToolsUpdateItem" Visibility="{Binding HostToolsUpdateVisibility}"><Button x:Name="HostToolsUpdateButton" Content="{Binding HostToolsUpdateText}" Padding="7,1" MinHeight="22" Click="Preferences_Click"/></StatusBarItem>
                <StatusBarItem Grid.Column="5" Visibility="{Binding TimerVisibility}"><TextBlock Text="{Binding ElapsedText}" FontFamily="Consolas" Margin="12,0"/></StatusBarItem>
                <StatusBarItem Grid.Column="6" Padding="2,0" HorizontalAlignment="Right"><Button Style="{StaticResource StatusIconButton}" ToolTip="{l:Loc Common.Console}" AutomationProperties.Name="{l:Loc Common.Console}" Click="ToggleConsole_Click"><Path Width="17" Height="15" Data="M1,2 H17 V14 H1 Z M4,6 L7,8 L4,10 M9,10 H14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round" Stretch="Uniform"/></Button></StatusBarItem>
                <StatusBarItem x:Name="HardwareSelectorItem" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
