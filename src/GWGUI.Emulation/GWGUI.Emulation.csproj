<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>gwgui.emulation</AssemblyName>
    <PackageId>GWGUI.Emulation.SDK</PackageId>
    <Version>1.0.1</Version>
    <Description>Versioned contracts for independent GW GUI emulation modules.</Description>
    <Authors>overthetop78</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/overthetop78/GW-GUI</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <PackageReference Include="LTRData.DiscUtils.Vhd" Version="1.0.88" />
    <PackageReference Include="LTRData.DiscUtils.Vhdx" Version="1.0.88" />
    <PackageReference Include="LTRData.DiscUtils.Vdi" Version="1.0.88" />
    <PackageReference Include="LTRData.DiscUtils.Vmdk" Version="1.0.88" />
    <PackageReference Include="LTRData.DiscUtils.Fat" Version="1.0.88" />
    <PackageReference Include="LTRData.DiscUtils.Ntfs" Version="1.0.88" />
    <PackageReference Include="LTRData.DiscUtils.ExFat" Version="1.0.88" />
    <PackageReference Include="LTRData.DiscUtils.Ext" Version="1.0.88" />
    <PackageReference Include="LTRData.DiscUtils.HfsPlus" Version="1.0.88" />
    <InternalsVisibleTo Include="GWGUI.Emulation.Amiga" />
    <InternalsVisibleTo Include="GWGUI.Emulation.Atari" />
    <InternalsVisibleTo Include="GWGUI.Tests" />
  </ItemGroup>
</Project>
